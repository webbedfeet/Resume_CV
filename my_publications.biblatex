@misc{landy_causal_2025,
	title = {Causal Inference for Latent Outcomes Learned with Factor Models},
	url = {http://arxiv.org/abs/2506.20549},
	doi = {10.48550/arXiv.2506.20549},
	abstract = {In many fields\${\textbackslash}unicode\{x2013\}\$including genomics, epidemiology, natural language processing, social and behavioral sciences, and economics\${\textbackslash}unicode\{x2013\}\$it is increasingly important to address causal questions in the context of factor models or representation learning. In this work, we investigate causal effects on \${\textbackslash}textit\{latent outcomes\}\$ derived from high-dimensional observed data using nonnegative matrix factorization. To the best of our knowledge, this is the first study to formally address causal inference in this setting. A central challenge is that estimating a latent factor model can cause an individual's learned latent outcome to depend on other individuals' treatments, thereby violating the standard causal inference assumption of no interference. We formalize this issue as \${\textbackslash}textit\{learning-induced interference\}\$ and distinguish it from interference present in a data-generating process. To address this, we propose a novel, intuitive, and theoretically grounded algorithm to estimate causal effects on latent outcomes while mitigating learning-induced interference and improving estimation efficiency. We establish theoretical guarantees for the consistency of our estimator and demonstrate its practical utility through simulation studies and an application to cancer mutational signature analysis. All baseline and proposed methods are available in our open-source R package, \$\{{\textbackslash}tt {causalLFO}\}\$.},
	number = {{arXiv}:2506.20549},
	publisher = {{arXiv}},
	author = {Landy, Jenna M. and Zorzetto, Dafne and Vito, Roberta De and Parmigiani, Giovanni},
	urldate = {2025-07-02},
	date = {2025-06-26},
	eprinttype = {arxiv},
	eprint = {2506.20549 [stat]},
	keywords = {Statistics - Methodology},
	file = {Preprint PDF:/Users/abhijit/Zotero/storage/KUC4EDXF/Landy et al. - 2025 - Causal Inference for Latent Outcomes Learned with Factor Models.pdf:application/pdf;Snapshot:/Users/abhijit/Zotero/storage/888IR5RC/2506.html:text/html},
}

