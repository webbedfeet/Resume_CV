	file = {PDF:/Users/abhijit/Zotero/storage/VKPQS8NC/Necchi et al. - 2025 - End Points for the Next-Generation Bladder-Sparing Perioperative Trials for Patients With Muscle-Inv.pdf:application/pdf},
