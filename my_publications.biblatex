@article{kassahun-yimer_joint_2020,
	title = {Joint modelling of longitudinal lipids and time to coronary heart disease in the Jackson Heart Study},
	volume = {20},
	issn = {1471-2288},
	url = {https://doi.org/10.1186/s12874-020-01177-7},
	doi = {10.1186/s12874-020-01177-7},
	abstract = {Multiple longitudinal responses together with time-to-event outcome are common in biomedical studies. There are several instances where the longitudinal responses are correlated with each other and at the same time each longitudinal response is associated with the survival outcome. The main purpose of this study is to present and explore a joint modeling approach for multiple correlated longitudinal responses and a survival outcome. The method will be illustrated using the Jackson Heart Study ({JHS}), which is one of the largest cardiovascular studies among African Americans.},
	pages = {294},
	number = {1},
	journaltitle = {{BMC} Medical Research Methodology},
	author = {Kassahun-Yimer, Wondwosen and Valle, Karen A. and Oshunbade, Adebamike A. and Hall, Michael E. and Min, Yuan-I. and Cain-Shields, Loretta and Anugu, Pramod and Correa, Adolfo},
