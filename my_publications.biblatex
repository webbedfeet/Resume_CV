@article{kohler_joint_2017,
	title = {Joint modeling of longitudinal autoantibody patterns and progression to type 1 diabetes: results from the {TEDDY} study},
	volume = {54},
	issn = {1432-5233},
	url = {https://doi.org/10.1007/s00592-017-1033-7},
	doi = {10.1007/s00592-017-1033-7},
	shorttitle = {Joint modeling of longitudinal autoantibody patterns and progression to type 1 diabetes},
	abstract = {The onset of clinical type 1 diabetes (T1D) is preceded by the occurrence of disease-specific autoantibodies. The level of autoantibody titers is known to be associated with progression time from the first emergence of autoantibodies to the onset of clinical symptoms, but detailed analyses of this complex relationship are lacking. We aimed to fill this gap by applying advanced statistical models.},
	pages = {1009--1017},
	number = {11},
