@article{berry_bayesian_2006-1,
	title = {Bayesian clinical trials},
	volume = {5},
	rights = {2006 Springer Nature Limited},
	issn = {1474-1784},
	url = {https://www.nature.com/articles/nrd1927},
	doi = {10.1038/nrd1927},
	abstract = {Bayesian statistical methods are being increasingly used in clinical research owing to the advantages they can offer compared with conventional approaches. Berry explains the underlying rationale, and discusses the potential of Bayesian trials to improve the effectiveness of drug development.},
