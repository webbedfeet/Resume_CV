@article{thomas_tutorial_2014,
	title = {Tutorial: Survival Estimation for Cox Regression Models with Time-Varying Coeﬃcients Using {SAS} and R},
	volume = {61},
	issn = {1548-7660},
	doi = {http://dx.doi.org/10.18637/jss.v061.c01},
	abstract = {Survival estimates are an essential compliment to multivariable regression models for time-to-event data, both for prediction and illustration of covariate eﬀects. They are easily obtained under the Cox proportional-hazards model. In populations deﬁned by an initial, acute event, like myocardial infarction, or in studies with long-term follow-up, the proportional-hazards assumption of constant hazard ratios is frequently violated.{\textbackslash}r{\textbackslash}{nOne} alternative is to ﬁt an interaction between covariates and a prespeciﬁed function of time, implemented as a time-dependent covariate. This eﬀectively creates a time-varying coeﬃcient that is easily estimated in software such as {SAS} and R. However, the usual{\textbackslash}r{\textbackslash}nprogramming statements for survival estimation are not directly applicable. Unique data manipulation and syntax is required, but is not well documented for either software.{\textbackslash}r{\textbackslash}{nThis} paper oﬀers a tutorial in survival estimation for the time-varying coeﬃcient model, implemented in {SAS} and R. We provide a macro coxtvc to facilitate estimation in {SAS}{\textbackslash}r{\textbackslash}nwhere the current functionality is more limited. The macro is validated in simulated data{\textbackslash}r{\textbackslash}nand illustrated in an application.},
	pages = {1--23},
	issue = {October},
	journaltitle = {Journal of Statistical Software},
	author = {Thomas, Laine and Reyes, Eric},
	date = {2014},
	note = {Number: October},
	keywords = {time-dependent covariates, cox proportional-hazards, model, r, sas, survival estimation, time-varying coefficients},
}

