@article{fewell_controlling_2004,
	title = {Controlling for Time-dependent Confounding using Marginal Structural Models},
	volume = {4},
	issn = {1536-867X},
	url = {https://doi.org/10.1177/1536867X0400400403},
	doi = {10.1177/1536867X0400400403},
	abstract = {Longitudinal studies in which exposures, confounders, and outcomes are measured repeatedly over time have the potential to allow causal inferences about the effects of exposure on outcome. There is particular interest in estimating the causal effects of medical treatments (or other interventions) in circumstances in which a randomized controlled trial is difficult or impossible. However, standard methods for estimating exposure effects in longitudinal studies are biased in the presence of time-dependent confounders affected by prior treatment., This article describes the use of marginal structural models (described by Robins, Hernán, and Brumback [2000]) to estimate exposure or treatment effects in the presence of time-dependent confounders affected by prior treatment. The method is based on deriving inverse-probability-of-treatment weights, which are then used in a pooled logistic regression model to estimate the causal effect of treatment on outcome. We demonstrate the use of marginal structural models to estimate the effect of methotrexate on mortality in persons suffering from rheumatoid arthritis.},
	pages = {402--420},
	number = {4},
	journaltitle = {The Stata Journal},
	author = {Fewell, Zoe and Hernán, Miguel A. and Wolfe, Frederick and Tilling, Kate and Choi, Hyon and Sterne, Jonathan A. C.},
	urldate = {2020-12-08},
	date = {2004-12-01},
	langid = {english},
	note = {Publisher: {SAGE} Publications},
	keywords = {survival analysis, confounding, logistic regression, causal models, marginal structural models, st0075, weighted regression},
	file = {Fewell et al. - 2004 - Controlling for Time-dependent Confounding using M.pdf:/Users/abhijit/Zotero/storage/RTLUJVW6/Fewell et al. - 2004 - Controlling for Time-dependent Confounding using M.pdf:application/pdf;Fewell et al. - Controlling for Time-dependent Confounding using M.pdf:/Users/abhijit/Zotero/storage/AAAEVJL4/Fewell et al. - Controlling for Time-dependent Confounding using M.pdf:application/pdf},
}

@article{ediebah_joint_2015,
	title = {Joint modeling of longitudinal health-related quality of life data and survival},
	volume = {24},
	issn = {1573-2649},
	doi = {10.1007/s11136-014-0821-6},
	abstract = {{PURPOSE}: In cancer research, outcome measures may co-vary. Treatment and treatment related impairment of health-related quality of life ({HRQoL}) may affect survival. When these effects are analyzed separately, bias may arise. Therefore, we investigated the combined effect of treatment and longitudinally measured {HRQoL} on survival.
{METHODS}: Patients with anaplastic oligodendrogliomas (n = 288) who were randomized ({EORTC} 26951) to radiotherapy ({RT}) alone or {RT} plus procarbazine, lomustine, and vincristine ({PCV}) chemotherapy were analyzed. {HRQoL} [appetite loss ({AP})] was assessed with the {EORTC} {QLQ}-C30. We compared survival results from different analysis strategies: Cox model with treatment only [model 1 (M1)] or with treatment and time-dependent {AP} score [model 2 (M2)] and the joint model combining longitudinal {AP} score and survival [model 3 (M3)].
{RESULTS}: The estimated hazard ratio ({HR}) for {RT} plus {PCV} was 0.76 (95 \% {CI} 0.58-1.00) for M1, 0.72 (0.55-0.96) for M2, and 0.69 (0.52-0.92) for M3. This corresponds to a lower risk of death of 24 \% in M1, 28 \% in M2, and 31 \% in M3, for patients treated with {RT} plus {PCV} chemotherapy. {AP} resulted in an increased risk of death, with estimated {HR} of 1.06 (1.01-1.12) for M2 and 1.13 (1.03-1.23) for M3: Every 10-point increase of {AP} resulted in a 13 \% increased risk of death in M3 as compared to 6 \% in M2.
{CONCLUSION}: Part of the survival benefit of treatment with {RT} plus {PCV} chemotherapy can be masked by the negative effect that this treatment has on patients' {HRQoL}. In our study, up to 7 \% of the theoretical treatment efficacy was lost when {AP} was not adjusted through joint modeling.},
	pages = {795--804},
	number = {4},
	journaltitle = {Qual Life Res},
	author = {Ediebah, Divine E. and Galindo-Garre, Francisca and Uitdehaag, Bernard M. J. and Ringash, Jolie and Reijneveld, Jaap C. and Dirven, Linda and Zikos, Efstathios and Coens, Corneel and van den Bent, Martin J. and Bottomley, Andrew and Taphoorn, Martin J. B.},
	date = {2015-04},
	pmid = {25311306},
	keywords = {Humans, Quality of Life, Models, Statistical, Female, Aged, Middle Aged, Treatment Outcome, Adolescent, Adult, Male, Antineoplastic Combined Chemotherapy Protocols, Brain Neoplasms, Lomustine, Oligodendroglioma, Outcome Assessment, Health Care, Procarbazine, Surveys and Questionnaires, Time, Vincristine, Young Adult},
	file = {Ediebah et al. - 2015 - Joint modeling of longitudinal health-related qual.pdf:/Users/abhijit/Zotero/storage/ZZ4AZKWQ/Ediebah et al. - 2015 - Joint modeling of longitudinal health-related qual.pdf:application/pdf;Ediebah et al. - 2015 - Joint modeling of longitudinal health-related qual.pdf:/Users/abhijit/Zotero/storage/ZKPXU9N7/Ediebah et al. - 2015 - Joint modeling of longitudinal health-related qual.pdf:application/pdf},
}

@article{doersch_tutorial_2016,
	title = {Tutorial on Variational Autoencoders},
	url = {http://arxiv.org/abs/1606.05908},
	abstract = {In just three years, Variational Autoencoders ({VAEs}) have emerged as one of the most popular approaches to unsupervised learning of complicated distributions. {VAEs} are appealing because they are built on top of standard function approximators (neural networks), and can be trained with stochastic gradient descent. {VAEs} have already shown promise in generating many kinds of complicated data, including handwritten digits, faces, house numbers, {CIFAR} images, physical models of scenes, segmentation, and predicting the future from static images. This tutorial introduces the intuitions behind {VAEs}, explains the mathematics behind them, and describes some empirical behavior. No prior knowledge of variational Bayesian methods is assumed.},
	journaltitle = {{arXiv}:1606.05908 [cs, stat]},
	author = {Doersch, Carl},
	urldate = {2020-11-02},
	date = {2016-08-13},
	eprinttype = {arxiv},
	eprint = {1606.05908},
	keywords = {Statistics - Machine Learning, Computer Science - Machine Learning},
	file = {Doersch - 2016 - Tutorial on Variational Autoencoders.pdf:/Users/abhijit/Zotero/storage/2US2H32F/Doersch - 2016 - Tutorial on Variational Autoencoders.pdf:application/pdf;Doersch - Tutorial on Variational Autoencoders.pdf:/Users/abhijit/Zotero/storage/ERZ6WSUV/Doersch - Tutorial on Variational Autoencoders.pdf:application/pdf},
}

