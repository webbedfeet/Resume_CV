@article{wang_joint_2025,
	title = {Joint Modeling of Longitudinal and Survival Data},
	volume = {12},
	issn = {2326-8298, 2326-831X},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev-statistics-112723-034334},
	doi = {10.1146/annurev-statistics-112723-034334},
	abstract = {In medical studies, time-to-event outcomes such as time to death or relapse of a disease are routinely recorded along with longitudinal data that are observed intermittently during the follow-up period. For various reasons, marginal approaches to model the event time, corresponding to separate approaches for survival data/longitudinal data, tend to induce bias and lose efficiency. Instead, a joint modeling approach that brings the two types of data together can reduce or eliminate the bias and yield a more efficient estimation procedure. A well-established avenue for joint modeling is the joint likelihood approach that often produces semiparametric efficient estimators for the finite-dimensional parameter vectors in both models. Through a transformation survival model with an unspecified baseline hazard function, this review introduces joint modeling that accommodates both baseline covariates and time-varying covariates. The focus is on the major challenges faced by joint modeling and how they can be overcome. A review of available software implementations and a brief discussion of future directions of the field are also included.},
	pages = {449--476},
	issue = {Volume 12, 2025},
	journaltitle = {Annual Review of Statistics and Its Application},
	author = {Wang, Jane-Ling and Zhong, Qixian},
	urldate = {2025-07-11},
	date = {2025-03-07},
	langid = {english},
	note = {Publisher: Annual Reviews},
	file = {PDF:/Users/abhijit/Zotero/storage/GQKBRT8Q/Wang and Zhong - 2025 - Joint Modeling of Longitudinal and Survival Data.pdf:application/pdf;Snapshot:/Users/abhijit/Zotero/storage/TNJ8MDQ2/annurev-statistics-112723-034334.html:text/html},
}

@article{wood_generalized_2025,
	title = {Generalized Additive Models},
	volume = {12},
	issn = {2326-8298, 2326-831X},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev-statistics-112723-034249},
	doi = {10.1146/annurev-statistics-112723-034249},
	abstract = {Generalized additive models are generalized linear models in which the linear predictor includes a sum of smooth functions of covariates, where the shape of the functions is to be estimated. They have also been generalized beyond the original generalized linear model setting to distributions outside the exponential family and to situations in which multiple parameters of the response distribution may depend on sums of smooth functions of covariates. The widely used computational and inferential framework in which the smooth terms are represented as latent Gaussian processes, splines, or Gaussian random effects is reviewed, paying particular attention to the case in which computational and theoretical tractability is obtained by prior rank reduction of the model terms. An empirical Bayes approach is taken, and its relatively good frequentist performance discussed, along with some more overtly frequentist approaches to model selection. Estimation of the degree of smoothness of component functions via cross validation or marginal likelihood is covered, alongside the computational strategies required in practice, including when data and models are reasonably large. It is briefly shown how the framework extends easily to location-scale modeling, and, with more effort, to techniques such as quantile regression. Also covered are the main classes of smooths of multiple covariates that may be included in models: isotropic splines and tensor product smooth interaction terms.},
	pages = {497--526},
	issue = {Volume 12, 2025},
	journaltitle = {Annual Review of Statistics and Its Application},
	author = {Wood, Simon N.},
	urldate = {2025-07-11},
	date = {2025-03-07},
	langid = {english},
	note = {Publisher: Annual Reviews},
	file = {PDF:/Users/abhijit/Zotero/storage/N4HDFI83/2024 - From theory to practice implementing targeted learning for causal inference using real-world data .pdf:application/pdf;Snapshot:/Users/abhijit/Zotero/storage/8IUCCGMJ/annurev-statistics-112723-034249.html:text/html},
}

@article{amico_cure_2018,
	title = {Cure Models in Survival Analysis},
	volume = {5},
	issn = {2326-8298, 2326-831X},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev-statistics-031017-100101},
	doi = {10.1146/annurev-statistics-031017-100101},
	abstract = {When analyzing time-to-event data, it often happens that a certain fraction of the data corresponds to subjects who will never experience the event of interest. These event times are considered as infinite and the subjects are said to be cured. Survival models that take this feature into account are commonly referred to as cure models. This article reviews the literature on cure regression models in which the event time (response) is subject to random right censoring and has a positive probability to be equal to infinity.},
	pages = {311--342},
	issue = {Volume 5, 2018},
	journaltitle = {Annual Review of Statistics and Its Application},
	author = {Amico, Maïlis and Keilegom, Ingrid Van},
	urldate = {2025-07-11},
	date = {2018-03-07},
	langid = {english},
	note = {Publisher: Annual Reviews},
	file = {Full Text:/Users/abhijit/Zotero/storage/ZAJABNS6/Amico and Keilegom - 2018 - Cure Models in Survival Analysis.pdf:application/pdf;Snapshot:/Users/abhijit/Zotero/storage/M294BMKK/annurev-statistics-031017-100101.html:text/html},
}

