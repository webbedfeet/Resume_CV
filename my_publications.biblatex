@article{tomer_personalized_2019-1,
	title = {Personalized schedules for surveillance of low-risk prostate cancer patients},
	volume = {75},
	issn = {1541-0420},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/biom.12940},
	doi = {https://doi.org/10.1111/biom.12940},
	abstract = {Low-risk prostate cancer patients enrolled in active surveillance ({AS}) programs commonly undergo biopsies on a frequent basis for examination of cancer progression. {AS} programs employ a fixed schedule of biopsies for all patients. Such fixed and frequent schedules may schedule unnecessary biopsies. Since biopsies are burdensome, patients do not always comply with the schedule, which increases the risk of delayed detection of cancer progression. Motivated by the world's largest {AS} program, Prostate Cancer Research International Active Surveillance ({PRIAS}), we present personalized schedules for biopsies to counter these problems. Using joint models for time-to-event and longitudinal data, our methods combine information from historical prostate-specific antigen levels and repeat biopsy results of a patient, to schedule the next biopsy. We also present methods to compare personalized schedules with existing biopsy schedules.},
	pages = {153--162},
	number = {1},
	journaltitle = {Biometrics},
	author = {Tomer, Anirudh and Nieboer, Daan and Roobol, Monique J. and Steyerberg, Ewout W. and Rizopoulos, Dimitris},
	urldate = {2020-11-29},
	date = {2019},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/biom.12940},
	keywords = {Active surveillance, Biopsy, Prostate cancer, Joint models, Personalized medicine},
}

@article{erler_bayesian_2019,
	title = {Bayesian imputation of time-varying covariates in linear mixed models},
	volume = {28},
	issn = {0962-2802},
	url = {https://doi.org/10.1177/0962280217730851},
	doi = {10.1177/0962280217730851},
	abstract = {Studies involving large observational datasets commonly face the challenge of dealing with multiple missing values. The most popular approach to overcome this challenge, multiple imputation using chained equations, however, has been shown to be sub-optimal in complex settings, specifically in settings with longitudinal outcomes, which cannot be easily and adequately included in the imputation models. Bayesian methods avoid this difficulty by specification of a joint distribution and thus offer an alternative. A popular choice for that joint distribution is the multivariate normal distribution. In more complicated settings, as in our two motivating examples that involve time-varying covariates, additional issues require consideration: the endo- or exogeneity of the covariate and its functional relation with the outcome. In such situations, the implied assumptions of standard methods may be violated, resulting in bias. In this work, we extend and study a more flexible, Bayesian alternative to the multivariate normal approach, to better handle complex incomplete longitudinal data. We discuss and compare assumptions of the two Bayesian approaches about the endo- or exogeneity of the covariates and the functional form of the association with the outcome, and illustrate and evaluate consequences of violations of those assumptions using simulation studies and two real data examples.},
	pages = {555--568},
	number = {2},
	journaltitle = {Stat Methods Med Res},
	author = {Erler, Nicole S and Rizopoulos, Dimitris and Jaddoe, Vincent {WV} and Franco, Oscar H and Lesaffre, Emmanuel {MEH}},
	urldate = {2020-11-29},
	date = {2019-02-01},
	note = {Publisher: {SAGE} Publications Ltd {STM}},
	file = {Full Text:/Users/abhijit/Zotero/storage/6YM8N7GA/Erler et al. - 2019 - Bayesian imputation of time-varying covariates in .pdf:application/pdf},
}

