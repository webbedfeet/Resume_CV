@article{Katz2006,
	title = {The (relative) risks of using odds ratios.},
	volume = {142},
	url = {http://eutils.ncbi.nlm.nih.gov/entrez/eutils/elink.fcgi?dbfrom=pubmed&id=16785380&retmode=ref&cmd=prlinks},
	abstract = {Odds ratios are commonly presented in the medical literature, including dermatology journals. Even when used appropriately, odds ratios are often difficult to interpret. This article illustrates this problem using an example from the recent dermatology literature. It then reviews the definitions of odds and odds ratio, as well as how odds and odds ratio relate to probability and relative risk. The divergence of odds ratios from relative risks when events are common (occurring in {\textgreater} or =10\% of a sample) is explained. Methods to convert odds ratios to relative risks (and the reasons why conversion should be considered) are discussed.},
	pages = {761--764},
	number = {6},
	journaltitle = {Archives of dermatology},
	author = {Katz, Kenneth A},
	date = {2006},
	note = {Number: 6
Place: Department of Dermatology, University of Pennsylvania School of Medicine, Philadelphia, {PA} 19104, {USA}. Kenneth.Katz@post.harvard.edu},
}

