@article{ou_biomarker_2021,
	title = {Biomarker Discovery and Validation: Statistical Considerations},
	volume = {16},
	issn = {1556-0864},
	url = {https://www.sciencedirect.com/science/article/pii/S1556086421016634},
	doi = {10.1016/j.jtho.2021.01.1616},
	shorttitle = {Biomarker Discovery and Validation},
	abstract = {Biomarkers have various applications including disease detection, diagnosis, prognosis, prediction of response to intervention, and disease monitoring. In this era of precision medicine, having validated biomarkers to inform clinical decision making is more important than ever. In this article, we discuss best the practices and potential issues in biomarker discovery and validation. We encourage team science partnerships to bring cutting-edge discovery from bench to bedside, leading to improved patient care and outcomes.},
	pages = {537--545},
	number = {4},
	journaltitle = {Journal of Thoracic Oncology},
	author = {Ou, Fang-Shu and Michiels, Stefan and Shyr, Yu and Adjei, Alex A. and Oberg, Ann L.},
	urldate = {2023-06-27},
