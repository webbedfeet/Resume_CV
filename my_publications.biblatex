	number = {21},
	journaltitle = {New England Journal of Medicine},
	author = {Forde, Patrick M. and Spicer, Jonathan and Lu, Shun and Provencio, Mariano and Mitsudomi, Tetsuya and Awad, Mark M. and Felip, Enriqueta and Broderick, Stephen R. and Brahmer, Julie R. and Swanson, Scott J. and Kerr, Keith and Wang, Changli and Ciuleanu, Tudor-Eliade and Saylors, Gene B. and Tanaka, Fumihiro and Ito, Hiroyuki and Chen, Ke-Neng and Liberman, Moishe and Vokes, Everett E. and Taube, Janis M. and Dorange, Cecile and Cai, Junliang and Fiore, Joseph and Jarkowski, Anthony and Balli, David and Sausen, Mark and Pandya, Dimple and Calvet, Christophe Y. and Girard, Nicolas},
	urldate = {2024-11-12},
	date = {2022-05-25},
	note = {Publisher: Massachusetts Medical Society
\_eprint: https://www.nejm.org/doi/pdf/10.1056/{NEJMoa}2202170},
	file = {Full Text PDF:/Users/abhijit/Zotero/storage/HDQ62A9Y/Forde et al. - 2022 - Neoadjuvant Nivolumab plus Chemotherapy in Resectable Lung Cancer.pdf:application/pdf},
}

