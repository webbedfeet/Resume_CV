@article{grossman_neoadjuvant_2003,
	title = {Neoadjuvant Chemotherapy plus Cystectomy Compared with Cystectomy Alone for Locally Advanced Bladder Cancer},
	volume = {349},
	issn = {0028-4793},
	url = {https://doi.org/10.1056/NEJMoa022148},
	doi = {10.1056/NEJMoa022148},
	abstract = {Bladder cancer, the fourth most common cancer in men and the eighth in women in the United States,1 is a worldwide problem.2 Tumors superficial to the muscularis propria are effectively treated with transurethral resection and intravesical therapy.3 After radical cystectomy for locally advanced bladder cancer, there is a significant rate of recurrence (56 percent among patients with pathological stage T3, in which there is invasion of perivesical tissue), most commonly as distant metastases.4 A previous Southwest Oncology Group ({SWOG}) study demonstrated that radiation therapy before radical cystectomy did not improve the outcome.5 For these reasons, systemic chemotherapy has been explored . . .},
	pages = {859--866},
	number = {9},
	journaltitle = {New England Journal of Medicine},
	author = {Grossman, H. Barton and Natale, Ronald B. and Tangen, Catherine M. and Speights, V.O. and Vogelzang, Nicholas J. and Trump, Donald L. and White, Ralph W. {deVere} and Sarosdy, Michael F. and Wood, David P. and Raghavan, Derek and Crawford, E. David},
	urldate = {2024-01-30},
	date = {2003-08-28},
	pmid = {12944571},
	note = {Publisher: Massachusetts Medical Society
\_eprint: https://doi.org/10.1056/{NEJMoa}022148},
	file = {Full Text PDF:/Users/abhijit/Zotero/storage/ZQ798MIU/Grossman et al. - 2003 - Neoadjuvant Chemotherapy plus Cystectomy Compared .pdf:application/pdf},
}

@article{galsky_gemcitabine_2023,
	title = {Gemcitabine and cisplatin plus nivolumab as organ-sparing treatment for muscle-invasive bladder cancer: a phase 2 trial},
	volume = {29},
	issn = {1078-8956, 1546-170X},
	url = {https://www.nature.com/articles/s41591-023-02568-1},
	doi = {10.1038/s41591-023-02568-1},
	shorttitle = {Gemcitabine and cisplatin plus nivolumab as organ-sparing treatment for muscle-invasive bladder cancer},
	abstract = {Abstract
            
              Cystectomy is a standard treatment for muscle-invasive bladder cancer ({MIBC}), but it is life-altering. We initiated a phase 2 study in which patients with {MIBC} received four cycles of gemcitabine, cisplatin, plus nivolumab followed by clinical restaging. Patients achieving a clinical complete response ({cCR}) could proceed without cystectomy. The co-primary objectives were to assess the {cCR} rate and the positive predictive value of {cCR} for a composite outcome: 2-year metastasis-free survival in patients forgoing immediate cystectomy or {\textless}{ypT}1N0 in patients electing immediate cystectomy. Seventy-six patients were enrolled; of these, 33 achieved a {cCR} (43\%, 95\% confidence interval ({CI}): 32\%, 55\%), and 32 of 33 who achieved a {cCR} opted to forgo immediate cystectomy. The positive predictive value of {cCR} was 0.97 (95\% {CI}: 0.91, 1), meeting the co-primary objective. The most common adverse events were fatigue, anemia, neutropenia and nausea. Somatic alterations in pre-specified genes (
              {ATM}
              ,
              {RB}1
              ,
              {FANCC}
              and
              {ERCC}2
              ) or increased tumor mutational burden did not improve the positive predictive value of {cCR}. Exploratory analyses of peripheral blood mass cytometry and soluble protein analytes demonstrated an association between the baseline and on-treatment immune contexture with clinical outcomes. Stringently defined {cCR} after gemcitabine, cisplatin, plus nivolumab facilitated bladder sparing and warrants further study. {ClinicalTrials}.gov identifier:
              {NCT}03558087
              .},
	pages = {2825--2834},
	number = {11},
	journaltitle = {Nat Med},
	author = {Galsky, Matthew D. and Daneshmand, Siamak and Izadmehr, Sudeh and Gonzalez-Kozlova, Edgar and Chan, Kevin G. and Lewis, Sara and Achkar, Bassam El and Dorff, Tanya B. and Cetnar, Jeremy Paul and Neil, Brock O. and D’Souza, Anishka and Mamtani, Ronac and Kyriakopoulos, Christos and Jun, Tomi and Gogerly-Moragoda, Mahalya and Brody, Rachel and Xie, Hui and Nie, Kai and Kelly, Geoffrey and Horowitz, Amir and Kinoshita, Yayoi and Ellis, Ethan and Nose, Yohei and Ioannou, Giorgio and Cabal, Rafael and Del Valle, Diane M. and Haines, G. Kenneth and Wang, Li and Mouw, Kent W. and Samstein, Robert M. and Mehrazin, Reza and Bhardwaj, Nina and Yu, Menggang and Zhao, Qianqian and Kim-Schulze, Seunghee and Sebra, Robert and Zhu, Jun and Gnjatic, Sacha and Sfakianos, John and Pal, Sumanta K.},
	urldate = {2024-01-30},
	date = {2023-11},
	langid = {english},
	file = {41591_2023_2568_MOESM1_ESM-2.pdf:/Users/abhijit/Zotero/storage/HAVFEBJL/41591_2023_2568_MOESM1_ESM-2.pdf:application/pdf;Galsky et al. - 2023 - Gemcitabine and cisplatin plus nivolumab as organ-.pdf:/Users/abhijit/Zotero/storage/M9X5KY8W/Galsky et al. - 2023 - Gemcitabine and cisplatin plus nivolumab as organ-.pdf:application/pdf;Stone - 2023 - Bladder-sparing neoadjuvant therapy for MIBC.pdf:/Users/abhijit/Zotero/storage/IQ5UG962/Stone - 2023 - Bladder-sparing neoadjuvant therapy for MIBC.pdf:application/pdf},
}

