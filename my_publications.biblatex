@article{lopez_deep_2018,
	title = {Deep generative modeling for single-cell transcriptomics},
	volume = {15},
	rights = {2018 The Author(s), under exclusive licence to Springer Nature America, Inc.},
	issn = {1548-7105},
	url = {https://www.nature.com/articles/s41592-018-0229-2},
	doi = {10.1038/s41592-018-0229-2},
	abstract = {Single-cell transcriptome measurements can reveal unexplored biological diversity, but they suffer from technical noise and bias that must be modeled to account for the resulting uncertainty in downstream analyses. Here we introduce single-cell variational inference ({scVI}), a ready-to-use scalable framework for the probabilistic representation and analysis of gene expression in single cells (https://github.com/{YosefLab}/{scVI}). {scVI} uses stochastic optimization and deep neural networks to aggregate information across similar cells and genes and to approximate the distributions that underlie observed expression values, while accounting for batch effects and limited sensitivity. We used {scVI} for a range of fundamental analysis tasks including batch correction, visualization, clustering, and differential expression, and achieved high accuracy for each task.},
	pages = {1053--1058},
	number = {12},
	journaltitle = {Nature Methods},
	author = {Lopez, Romain and Regier, Jeffrey and Cole, Michael B. and Jordan, Michael I. and Yosef, Nir},
	urldate = {2021-03-17},
	date = {2018-12},
	langid = {english},
	note = {Number: 12
Publisher: Nature Publishing Group},
	file = {Lopez_et_al-2018-Nature_Methods.pdf:/Users/abhijit/Zotero/storage/4XIKIVRD/Lopez_et_al-2018-Nature_Methods.pdf:application/pdf;Snapshot:/Users/abhijit/Zotero/storage/IUZ3TLMG/s41592-018-0229-2.html:text/html},
}

@article{huang_complete_2017,
	title = {Complete hazard ranking to analyze right-censored data: An {ALS} survival study},
	volume = {13},
	issn = {1553-7358},
	url = {https://journals.plos.org/ploscompbiol/article?id=10.1371/journal.pcbi.1005887},
	doi = {10.1371/journal.pcbi.1005887},
	shorttitle = {Complete hazard ranking to analyze right-censored data},
	abstract = {Survival analysis represents an important outcome measure in clinical research and clinical trials; further, survival ranking may offer additional advantages in clinical trials. In this study, we developed {GuanRank}, a non-parametric ranking-based technique to transform patients' survival data into a linear space of hazard ranks. The transformation enables the utilization of machine learning base-learners including Gaussian process regression, Lasso, and random forest on survival data. The method was submitted to the {DREAM} Amyotrophic Lateral Sclerosis ({ALS}) Stratification Challenge. Ranked first place, the model gave more accurate ranking predictions on the {PRO}-{ACT} {ALS} dataset in comparison to Cox proportional hazard model. By utilizing right-censored data in its training process, the method demonstrated its state-of-the-art predictive power in {ALS} survival ranking. Its feature selection identified multiple important factors, some of which conflicts with previous studies.},
	pages = {e1005887},
	number = {12},
	journaltitle = {{PLOS} Computational Biology},
	author = {Huang, Zhengnan and Zhang, Hongjiu and Boss, Jonathan and Goutman, Stephen A. and Mukherjee, Bhramar and Dinov, Ivo D. and Guan, Yuanfang and Consortium, for the Pooled Resource Open-Access {ALS} Clinical Trials},
	urldate = {2021-06-23},
	date = {2017-12-18},
	langid = {english},
	note = {Publisher: Public Library of Science},
	keywords = {Clinical trials, Machine learning, Survival analysis, Forecasting, Amyotrophic lateral sclerosis, Body weight, Machine learning algorithms, Ranking algorithms},
	file = {Huang et al_2017_Complete hazard ranking to analyze right-censored data.pdf:/Users/abhijit/Zotero/storage/IVDRQ458/Huang et al_2017_Complete hazard ranking to analyze right-censored data.pdf:application/pdf;Huang et al_2017_Complete hazard ranking to analyze right-censored data.pdf:/Users/abhijit/Zotero/storage/5VV2X8DP/Huang et al_2017_Complete hazard ranking to analyze right-censored data.pdf:application/pdf;Snapshot:/Users/abhijit/Zotero/storage/GYYSG25S/article.html:text/html},
}

@article{kretschmer_biomarkers_2017,
	title = {Biomarkers in prostate cancer – Current clinical utility and future perspectives},
	volume = {120},
	issn = {1040-8428},
	url = {http://www.sciencedirect.com/science/article/pii/S1040842817303785},
	doi = {10.1016/j.critrevonc.2017.11.007},
	abstract = {Current tendencies in the treatment course of prostate cancer patients increase the need for reliable biomarkers that help in decision-making in a challenging clinical setting. Within the last decade, several novel biomarkers have been introduced. In the following comprehensive review article, we focus on diagnostic ({PHI}®, 4K score, {SelectMDx}®, {ConfirmMDx}®, {PCA}3, {MiPS}, {ExoDX}®, {mpMRI}) and prognostic ({OncotypeDX} {GPS}®, Prolaris®, {ProMark}®, {DNA}-ploidy, Decipher®) biomarkers that are in widespread clinical use and are supported by evidence. Hereby, we focus on multiple clinical situations in which innovative biomarkers may guide decision-making in prostate cancer therapy. In addition, we describe novel liquid biopsy approaches (circulating tumor cells, cell-free {DNA}) that have been described as predictive biomarkers in metastatic castration-resistant prostate cancer and might support an individual patient-centred oncological approach in the nearer future.},
	pages = {180--193},
	journaltitle = {Critical Reviews in Oncology/Hematology},
	author = {Kretschmer, Alexander and Tilki, Derya},
	urldate = {2021-01-13},
	date = {2017-12-01},
	langid = {english},
	keywords = {Biomarker, Predictive, Prognostic, Prostate cancer, Genetic marker, Molecular marker},
	file = {Kretschmer - 2017 - Biomarkers in prostate cancer – Current clinical u.pdf:/Users/abhijit/Zotero/storage/AZ5IJT6D/Kretschmer - 2017 - Biomarkers in prostate cancer – Current clinical u.pdf:application/pdf;ScienceDirect Snapshot:/Users/abhijit/Zotero/storage/X9EKB674/S1040842817303785.html:text/html},
}

@article{armero_bayesian_2020,
	title = {Bayesian joint models for longitudinal and survival data},
	url = {http://arxiv.org/abs/2005.12822},
	abstract = {This paper takes a quick look at Bayesian joint models ({BJM}) for longitudinal and survival data. A general formulation for {BJM} is examined in terms of the sampling distribution of the longitudinal and survival processes, the conditional distribution of the random effects and the prior distribution. Next a basic {BJM} defined in terms of a mixed linear model and a Cox survival regression models is discussed and some extensions and other Bayesian topics are briefly outlined.},
	journaltitle = {{arXiv}:2005.12822 [stat]},
	author = {Armero, Carmen},
	urldate = {2020-11-29},
	date = {2020-05-26},
	eprinttype = {arxiv},
	eprint = {2005.12822},
	note = {version: 1},
	keywords = {Statistics - Methodology},
	file = {Armero - 2020 - Bayesian joint models for longitudinal and surviva.pdf:/Users/abhijit/Zotero/storage/H4N3ZKYB/Armero - 2020 - Bayesian joint models for longitudinal and surviva.pdf:application/pdf;Armero - Bayesian joint models for longitudinal and surviva.pdf:/Users/abhijit/Zotero/storage/IELP4B3M/Armero - Bayesian joint models for longitudinal and surviva.pdf:application/pdf;Armero_2020_Bayesian joint models for longitudinal and survival data.pdf:/Users/abhijit/Zotero/storage/URUYE8LD/Armero_2020_Bayesian joint models for longitudinal and survival data.pdf:application/pdf;Armero_2020_Bayesian joint models for longitudinal and survival data.pdf:/Users/abhijit/Zotero/storage/RL8ETFQ3/Armero_2020_Bayesian joint models for longitudinal and survival data.pdf:application/pdf;arXiv.org Snapshot:/Users/abhijit/Zotero/storage/3FS2YZ3I/2005.html:text/html},
