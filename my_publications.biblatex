	author = {Clark, Jennifer and Muhlemann, Natalia and Natanegara, Fanni and Hartley, Andrew and Wenkert, Deborah and Wang, Fei and Harrell, Frank E. and Bray, Ross and {The Medical Outreach Subteam of the Drug Information Association Bayesian Scientific Working Group}},
	urldate = {2024-04-27},
	date = {2023-05-01},
	langid = {english},
	keywords = {Clinical trials, Bayesian methods, Bayesian barriers, Bayesian education, Medical school training},
	file = {Full Text PDF:/Users/abhijit/Zotero/storage/KWAJBT9Q/Clark et al. - 2023 - Why are not There More Bayesian Clinical Trials Perceived Barriers and Educational Preferences Amon.pdf:application/pdf},
