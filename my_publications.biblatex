Publisher: Nature Publishing Group},
	keywords = {Data integration, Software, cell annotation, scrna, Computational models, integration, harmony},
	file = {Kang et al_2021_Efficient and precise single-cell reference atlas mapping with Symphony.pdf:/Users/abhijit/Zotero/storage/YN9QSWQR/Kang et al_2021_Efficient and precise single-cell reference atlas mapping with Symphony.pdf:application/pdf;Snapshot:/Users/abhijit/Zotero/storage/R49GGB6P/s41467-021-25957-x.html:text/html},
}

@article{xu_probabilistic_2021,
	title = {Probabilistic harmonization and annotation of single-cell transcriptomics data with deep generative models},
	volume = {17},
	issn = {1744-4292},
	url = {https://www.embopress.org/doi/full/10.15252/msb.20209620},
	doi = {10.15252/msb.20209620},
	abstract = {Abstract As the number of single-cell transcriptomics datasets grows, the natural next step is to integrate the accumulating data to achieve a common ontology of cell types and states. However, it is not straightforward to compare gene expression levels across datasets and to automatically assign cell type labels in a new dataset based on existing annotations. In this manuscript, we demonstrate that our previously developed method, {scVI}, provides an effective and fully probabilistic approach for joint representation and analysis of {scRNA}-seq data, while accounting for uncertainty caused by biological and measurement noise. We also introduce single-cell {ANnotation} using Variational Inference ({scANVI}), a semi-supervised variant of {scVI} designed to leverage existing cell state annotations. We demonstrate that {scVI} and {scANVI} compare favorably to state-of-the-art methods for data integration and cell state annotation in terms of accuracy, scalability, and adaptability to challenging settings. In contrast to existing methods, {scVI} and {scANVI} integrate multiple datasets with a single generative model that can be directly used for downstream tasks, such as differential expression. Both methods are easily accessible through scvi-tools.},
	pages = {e9620},
	number = {1},
	journaltitle = {Molecular Systems Biology},
	author = {Xu, Chenling and Lopez, Romain and Mehlman, Edouard and Regier, Jeffrey and Jordan, Michael I and Yosef, Nir},
	urldate = {2021-03-17},
	date = {2021-01-01},
	note = {Publisher: John Wiley \& Sons, Ltd},
	keywords = {cell annotation, {scRNA}-seq, annotation, differential expression, generative models, harmonization, {scANVI}, variational inference},
	file = {Snapshot:/Users/abhijit/Zotero/storage/5CCQIELR/msb.html:text/html;Xu et al_2021_Probabilistic harmonization and annotation of single-cell transcriptomics data.pdf:/Users/abhijit/Zotero/storage/3V9IG6FW/Xu et al_2021_Probabilistic harmonization and annotation of single-cell transcriptomics data.pdf:application/pdf},
}

@article{moncada-torres_explainable_2021,
	title = {Explainable machine learning can outperform Cox regression predictions and provide insights in breast cancer survival},
	volume = {11},
	rights = {2021 The Author(s)},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-021-86327-7},
	doi = {10.1038/s41598-021-86327-7},
	abstract = {Cox Proportional Hazards ({CPH}) analysis is the standard for survival analysis in oncology. Recently, several machine learning ({ML}) techniques have been adapted for this task. Although they have shown to yield results at least as good as classical methods, they are often disregarded because of their lack of transparency and little to no explainability, which are key for their adoption in clinical settings. In this paper, we used data from the Netherlands Cancer Registry of 36,658 non-metastatic breast cancer patients to compare the performance of {CPH} with {ML} techniques (Random Survival Forests, Survival Support Vector Machines, and Extreme Gradient Boosting [{XGB}]) in predicting survival using the \$\$c\$\$-index. We demonstrated that in our dataset, {ML}-based models can perform at least as good as the classical {CPH} regression (\$\$c\$\$-index \$\${\textbackslash}sim {\textbackslash},0.63\$\$), and in the case of {XGB} even better (\$\$c\$\$-index \$\${\textbackslash}sim 0.73\$\$). Furthermore, we used Shapley Additive Explanation ({SHAP}) values to explain the models’ predictions. We concluded that the difference in performance can be attributed to {XGB}’s ability to model nonlinearities and complex interactions. We also investigated the impact of specific features on the models’ predictions as well as their corresponding insights. Lastly, we showed that explainable {ML} can generate explicit knowledge of how models make their predictions, which is crucial in increasing the trust and adoption of innovative {ML} techniques in oncology and healthcare overall.},
	pages = {6968},
	number = {1},
	journaltitle = {Sci Rep},
	author = {Moncada-Torres, Arturo and van Maaren, Marissa C. and Hendriks, Mathijs P. and Siesling, Sabine and Geleijnse, Gijs},
	urldate = {2021-06-22},
	date = {2021-03-26},
	langid = {english},
	note = {Bandiera\_abtest: a
Cc\_license\_type: cc\_by
Cg\_type: Nature Research Journals
Number: 1
Primary\_atype: Research
Publisher: Nature Publishing Group
Subject\_term: Breast cancer;Computer science;Scientific data
Subject\_term\_id: breast-cancer;computer-science;scientific-data},
	keywords = {survival analysis, machine learning, Breast cancer, Computer science, shapley, Scientific data, {xAI}},
	file = {Moncada-Torres et al_2021_Explainable machine learning can outperform Cox regression predictions and.pdf:/Users/abhijit/Zotero/storage/CB4ZBYSS/Moncada-Torres et al_2021_Explainable machine learning can outperform Cox regression predictions and.pdf:application/pdf;Moncada-Torres et al_2021_Explainable machine learning can outperform Cox regression predictions and.pdf:/Users/abhijit/Zotero/storage/ZALNCHVS/Moncada-Torres et al_2021_Explainable machine learning can outperform Cox regression predictions and.pdf:application/pdf;Moncada-Torres et al_2021_Explainable machine learning can outperform Cox regression predictions and.pdf:/Users/abhijit/Zotero/storage/VFWSPHPM/Moncada-Torres et al_2021_Explainable machine learning can outperform Cox regression predictions and.pdf:application/pdf;Moncada-Torres et al_2021_Explainable machine learning can outperform Cox regression predictions and.pdf:/Users/abhijit/Zotero/storage/YPTD9QUG/Moncada-Torres et al_2021_Explainable machine learning can outperform Cox regression predictions and.pdf:application/pdf;Snapshot:/Users/abhijit/Zotero/storage/DWQECZR6/s41598-021-86327-7.html:text/html;Snapshot:/Users/abhijit/Zotero/storage/PCPZHSZK/s41598-021-86327-7.html:text/html},
}

@article{rizopoulos_bayesian_2011,
	title = {A Bayesian semiparametric multivariate joint model for multiple longitudinal outcomes and a time-to-event},
	volume = {30},
	rights = {Copyright © 2011 John Wiley \& Sons, Ltd.},
	issn = {1097-0258},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/sim.4205},
	doi = {https://doi.org/10.1002/sim.4205},
	abstract = {Motivated by a real data example on renal graft failure, we propose a new semiparametric multivariate joint model that relates multiple longitudinal outcomes to a time-to-event. To allow for greater flexibility, key components of the model are modelled nonparametrically. In particular, for the subject-specific longitudinal evolutions we use a spline-based approach, the baseline risk function is assumed piecewise constant, and the distribution of the latent terms is modelled using a Dirichlet Process prior formulation. Additionally, we discuss the choice of a suitable parameterization, from a practitioner's point of view, to relate the longitudinal process to the survival outcome. Specifically, we present three main families of parameterizations, discuss their features, and present tools to choose between them. Copyright © 2011 John Wiley \& Sons, Ltd.},
	pages = {1366--1380},
	number = {12},
	journaltitle = {Statistics in Medicine},
	author = {Rizopoulos, Dimitris and Ghosh, Pulak},
	urldate = {2021-05-21},
	date = {2011},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/sim.4205},
	keywords = {survival analysis, joint modeling, Bayesian analysis, Dirichlet process prior, dropout, shared parameter model, splines, time-dependent covariates},
	file = {Rizopoulos_Ghosh_2011_A Bayesian semiparametric multivariate joint model for multiple longitudinal.pdf:/Users/abhijit/Zotero/storage/6CN8LGZX/Rizopoulos_Ghosh_2011_A Bayesian semiparametric multivariate joint model for multiple longitudinal.pdf:application/pdf},
}

@article{austin_graphical_2022,
	title = {Graphical calibration curves and the integrated calibration index ({ICI}) for competing risk models},
	volume = {6},
	issn = {2397-7523},
	url = {https://doi.org/10.1186/s41512-021-00114-6},
	doi = {10.1186/s41512-021-00114-6},
	abstract = {Assessing calibration—the agreement between estimated risk and observed proportions—is an important component of deriving and validating clinical prediction models. Methods for assessing the calibration of prognostic models for use with competing risk data have received little attention.},
