@inproceedings{Kulkarni2012,
	title = {Pruning of random forest classifiers: A survey and future directions},
	abstract = {Random Forest is an ensemble supervised machine learning technique.{\textbackslash}{nBased} on bagging and random feature selection, number of decision{\textbackslash}ntrees (base classifiers) is generated and majority voting is taken{\textbackslash}nfor classification. For effective learning and classification of{\textbackslash}{nRandom} Forest, there is need for reducing number of trees (Pruning){\textbackslash}nin Random Forest. We have presented here systematic survey of pruning{\textbackslash}nefforts of Random Forest classifier along with the required theoretical{\textbackslash}nbackground. Most of the work for pruning takes static approach while{\textbackslash}nrecently dynamic pruning is being targeted. We have also generated{\textbackslash}na Comparison Chart by taking relevant parameters. There is research{\textbackslash}nscope for analyzing behavior of Random forest, generating accurate{\textbackslash}nand diverse base decision trees, truly dynamic pruning algorithm{\textbackslash}nfor Random Forest classifier, and generating optimal subset of Random{\textbackslash}nforest.},
	pages = {64--68},
	booktitle = {Proceedings - 2012 International Conference on Data Science and Engineering, {ICDSE} 2012},
	author = {Kulkarni, Vrushali Y. and Sinha, Pradeep K.},
	date = {2012},
	keywords = {Machine Learning, Ensemble, Classification, Data Mining, Pruning, Random Forest},
}

