{OPEN} {IN} {VIEWER}},
	pages = {180--180},
	number = {3},
	journaltitle = {{JCO}},
	author = {Nakamura, Yoshiaki and Tsukada, Yuichiro and Matsuhashi, Nobuhisa and Murano, Tatsuro and Shiozawa, Manabu and Kato, Takeshi and Oki, Eiji and Goto, Masahiro and Kagawa, Yoshinori and Kanazawa, Akiyoshi and Ohta, Takashi and Ouchi, Akira and Bando, Hideaki and Uchigata, Hiroshi and Notake, Chiemi and Cai, Mingyang and Zhang, Shile and Rich, Thereasa A. and Banks, Kimberly and Yoshino, Takayuki},
