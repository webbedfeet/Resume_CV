	url = {https://www.sciencedirect.com/science/article/pii/S153561082200513X},
	doi = {10.1016/j.ccell.2022.10.022},
	abstract = {In the Circulating Cell-free Genome Atlas ({NCT}02889978) substudy 1, we evaluate several approaches for a circulating cell-free {DNA} ({cfDNA})-based multi-cancer early detection ({MCED}) test by defining clinical limit of detection ({LOD}) based on circulating tumor allele fraction ({cTAF}), enabling performance comparisons. Among 10 machine-learning classifiers trained on the same samples and independently validated, when evaluated at 98\% specificity, those using whole-genome ({WG}) methylation, single nucleotide variants with paired white blood cell background removal, and combined scores from classifiers evaluated in this study show the highest cancer signal detection sensitivities. Compared with clinical stage and tumor type, {cTAF} is a more significant predictor of classifier performance and may more closely reflect tumor biology. Clinical {LODs} mirror relative sensitivities for all approaches. The {WG} methylation feature best predicts cancer signal origin. {WG} methylation is the most promising technology for {MCED} and informs development of a targeted methylation {MCED} test.},
	pages = {1537--1549.e12},
	number = {12},
	journaltitle = {Cancer Cell},
	author = {Jamshidi, Arash and Liu, Minetta C. and Klein, Eric A. and Venn, Oliver and Hubbell, Earl and Beausang, John F. and Gross, Samuel and Melton, Collin and Fields, Alexander P. and Liu, Qinwen and Zhang, Nan and Fung, Eric T. and Kurtzman, Kathryn N. and Amini, Hamed and Betts, Craig and Civello, Daniel and Freese, Peter and Calef, Robert and Davydov, Konstantin and Fayzullina, Saniya and Hou, Chenlu and Jiang, Roger and Jung, Byoungsok and Tang, Susan and Demas, Vasiliki and Newman, Joshua and Sakarya, Onur and Scott, Eric and Shenoy, Archana and Shojaee, Seyedmehdi and Steffen, Kristan K. and Nicula, Virgil and Chien, Tom C. and Bagaria, Siddhartha and Hunkapiller, Nathan and Desai, Mohini and Dong, Zhao and Richards, Donald A. and Yeatman, Timothy J. and Cohn, Allen L. and Thiel, David D. and Berry, Donald A. and Tummala, Mohan K. and {McIntyre}, Kristi and Sekeres, Mikkael A. and Bryce, Alan and Aravanis, Alexander M. and Seiden, Michael V. and Swanton, Charles},
	urldate = {2023-04-20},
	date = {2022-12-12},
	langid = {english},
	keywords = {to read, ctdna, cancer screening, {CCGA}, {cfDNA}, {MCED}, multi-cancer early detection, single nucleotide variants, somatic copy number alterations, whole-genome bisulfite sequencing, whole-genome methylation},
	file = {Full Text PDF:/Users/abhijit/Zotero/storage/ZMP735N6/Jamshidi et al. - 2022 - Evaluation of cell-free DNA approaches for multi-c.pdf:application/pdf;Jamshidi et al_2022_Evaluation of cell-free DNA approaches for multi-cancer early detection.pdf:/Users/abhijit/Zotero/storage/VCT2BBDH/Jamshidi et al_2022_Evaluation of cell-free DNA approaches for multi-cancer early detection.pdf:application/pdf;ScienceDirect Snapshot:/Users/abhijit/Zotero/storage/VDSRYVYZ/S153561082200513X.html:text/html;Snapshot:/Users/abhijit/Zotero/storage/JFUIPGQX/S1535-6108(22)00513-X.html:text/html},
}

@article{chen_prognostic_2021,
	title = {Prognostic Significance of Blood-Based Multi-cancer Detection in Plasma Cell-Free {DNA}},
	volume = {27},
	issn = {1078-0432},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9401481/},
	doi = {10.1158/1078-0432.CCR-21-0417},
	abstract = {Purpose:
We recently reported the development of a cell-free {DNA} ({cfDNA}) targeted methylation ({TM})-based sequencing approach for a multi-cancer early detection ({MCED}) test that includes cancer signal origin prediction. Here, we evaluated the prognostic significance of cancer detection by the {MCED} test using longitudinal follow-up data.

Experimental Design:
As part of a Circulating Cell-free Genome Atlas ({CCGA}) substudy, plasma {cfDNA} samples were sequenced using a {TM} approach, and machine learning classifiers predicted cancer status and cancer signal origin. Overall survival ({OS}) of cancer participants in the first 3 years of follow-up was evaluated in relation to cancer detection by the {MCED} test and clinical characteristics.

Results:
Cancers not detected by the {MCED} test had significantly better {OS} (P {\textless} 0.0001) than cancers detected, even after accounting for other covariates, including clinical stage and method of clinical diagnosis (i.e., standard-of-care screening or clinical presentation with signs/symptoms). Additionally, cancers not detected by the {MCED} test had better {OS} than was expected when data were adjusted for age, stage, and cancer type from the Surveillance, Epidemiology, and End Results ({SEER}) program. In cancers with current screening options, the {MCED} test also differentiated more aggressive cancers from less aggressive cancers (P {\textless} 0.0001).

Conclusions:
Cancer detection by the {MCED} test was prognostic beyond clinical stage and method of diagnosis. Cancers not detected by the {MCED} test had better prognosis than cancers detected and {SEER}-based expected survival. Cancer detection and prognosis may be linked by the underlying biological factor of tumor fraction in {cfDNA}.},
	pages = {4221--4229},
	number = {15},
	journaltitle = {Clin Cancer Res},
	author = {Chen, Xiaoji and Dong, Zhao and Hubbell, Earl and Kurtzman, Kathryn N. and Oxnard, Geoffrey R. and Venn, Oliver and Melton, Collin and Clarke, Christina A. and Shaknovich, Rita and Ma, Ting and Meixiong, Gerry and Seiden, Michael V. and Klein, Eric A. and Fung, Eric T. and Liu, Minetta C.},
	urldate = {2023-04-20},
	date = {2021-08-01},
	pmid = {34088722},
	pmcid = {PMC9401481},
	keywords = {ctdna},
	file = {Chen et al_2021_Prognostic Significance of Blood-Based Multi-cancer Detection in Plasma.pdf:/Users/abhijit/Zotero/storage/FY9J3KE9/Chen et al_2021_Prognostic Significance of Blood-Based Multi-cancer Detection in Plasma.pdf:application/pdf},
}

@article{husain_tumor_2022,
	title = {Tumor Fraction Correlates With Detection of Actionable Variants Across {\textgreater} 23,000 Circulating Tumor {DNA} Samples},
	url = {https://ascopubs.org/doi/full/10.1200/PO.22.00261},
	doi = {10.1200/PO.22.00261},
	abstract = {{PURPOSE}
Profiling of circulating tumor {DNA} ({ctDNA}) is increasingly adopted in the management of solid tumors, concurrent with increased availability of more comprehensive {ctDNA} panels. However, variable {ctDNA} shed can result in variable assay sensitivity. We studied the relationship between {ctDNA} tumor fraction ({TF}) and detection of actionable alterations across cancer types.

{METHODS}
A total of 23,482 liquid biopsies ({LBx}) submitted between September 2020 and October 2021 were sequenced using a hybrid capture panel that reports genomic alterations ({GAs}) and genomic biomarkers across 324 cancer-related genes. The primary end points were the prevalence of targetable {GAs} by cancer type and detection in relationship to {ctDNA} {TF}. Sensitivity of detection in {LBx} was assessed in 1,289 patients with available tissue results.

{RESULTS}
94\% (n = 22,130) of {LBx} had detectable {ctDNA}, with a median {TF} of 2.2\%. {LBx} profiling detected {GAs} in National Comprehensive Cancer Network category 1 genes in 37\% of lung, 30\% of prostate, 36\% of breast, and 51\% of colon cancer cases. Potential germline {GAs} flagged on clinical reports were detected in genes including {BRCA}1/2, {PALB}2, {CHEK}2, and {ATM}. Polyclonal mutations in genes associated with resistance such as {AR}, {ESR}1, {RB}1, and {NF}1 were detected. The sensitivity of {LBx} to detect driver alterations identified in tissue biopsy from the same patient ranged from 58\% to 86\% but was consistently at or near 100\% in cases with {TF} ≥ 10\%.

{CONCLUSION}
Elevated {ctDNA} shed is associated with both high sensitivity and negative predictive value for detection of actionable {GAs}. The presence of elevated {TF} suggests adequate tumor profiling and may reduce the value of subsequent reflex to confirmatory tissue testing in patients with negative {LBx} results.},
	pages = {e2200261},
	number = {6},
	journaltitle = {{JCO} Precision Oncology},
	author = {Husain, Hatim and Pavlick, Dean C. and Fendler, Bernard J. and Madison, Russell W. and Decker, Brennan and Gjoerup, Ole and Parachoniak, Christine A. and {McLaughlin}-Drubin, Molly and Erlich, Rachel L. and Schrock, Alexa B. and Frampton, Garrett M. and Das Thakur, Meghna and Oxnard, Geoffrey R. and Tukachinsky, Hanna},
	urldate = {2023-04-20},
	date = {2022-07},
	note = {Publisher: Wolters Kluwer},
	keywords = {ctdna},
	file = {Husain et al_2022_Tumor Fraction Correlates With Detection of Actionable Variants Across 23,000.pdf:/Users/abhijit/Zotero/storage/UUD7QQDR/Husain et al_2022_Tumor Fraction Correlates With Detection of Actionable Variants Across 23,000.pdf:application/pdf},
}

