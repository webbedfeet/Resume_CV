@article{ickstadt_toward_2018,
	title = {Toward Integrative Bayesian Analysis in Molecular Biology},
	volume = {5},
	issn = {2326-8298, 2326-831X},
	url = {https://www.annualreviews.org/doi/10.1146/annurev-statistics-031017-100438},
	doi = {10.1146/annurev-statistics-031017-100438},
	abstract = {In the postgenome era, multiple types of molecular data for the same set of samples are often available and should be analyzed jointly in an integrative analysis in order to maximize the information gain. Bayesian methods are particularly well suited for integrating different biological data sources. In this article, we cover crucial tasks and corresponding methods with a focus on integrative analyses. We emphasize gene prioritization, model-based cluster approaches for subgroup identification, regression modeling, and prediction, as well as structure learning using network models. Our review introduces prior concepts for sparsity and variable selection and concludes with some aspects on validation and computation.},
	pages = {141--167},
	number = {1},
	journaltitle = {Annu. Rev. Stat. Appl.},
	author = {Ickstadt, Katja and Schäfer, Martin and Zucknick, Manuela},
	urldate = {2023-12-05},
