	abstract = {T cell exhaustion in breast tumours remains to be fully characterised. Here, single cell transcriptomics and imaging mass cytometry analysis of luminal breast tumours with or without exhausted T cells suggests distinct patterns of {PD}-1 and {CXCL}13 expression in T cells, and of {MHC}-I, but not {PD}-L1, expression in tumour cells.},
