  title = {Standard {{Operating Procedures}} ({{SOPs}}) for Non-Invasive Multiple Biomarkers Detection in an Academic Setting: {{A}} Critical Review of the Literature for the {{RENOVATE}} Study Protocol},
  shorttitle = {Standard {{Operating Procedures}} ({{SOPs}}) for Non-Invasive Multiple Biomarkers Detection in an Academic Setting},
  author = {Dameri, Martina and Cirmena, Gabriella and Ravera, Francesco and Ferrando, Lorenzo and Cuccarolo, Paola and Stabile, Mario and Fanelli, Giuseppe Nicolò and Nuzzo, Pier Vitale and Calabrese, Massimo and Tagliafico, Alberto and Ballestrero, Alberto and Zoppoli, Gabriele},
