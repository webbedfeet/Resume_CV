@article{Stanley2016,
  title = {Comparison of Performance of Exponential, {{Cox}} Proportional Hazards, Weibull and Frailty Survival Models for Analysis of Small Sample Size Data},
  author = {Stanley, Christopher and Molyneux, Elizabeth and Mukaka, Mavuto},
  date = {2016},
  journaltitle = {Journal of Medical Statistics and Informatics},
  volume = {4},
  number = {1},
  pages = {2},
  issn = {2053-7662},
  doi = {10.7243/2053-7662-4-2},
  url = {http://www.hoajonline.com/medicalstat/2053-7662/4/2},
  abstract = {Abstract Background: The Cox Proportional Hazards(PH) model is commonest survival data model used in clinical trials. However, little is known as to whether or not this approach is robust to the size of the study. We compared performance of Cox, Weibull, Exponential and Frailty models in a randomized study that had a small sample size in general. Methods: Models were fitted to data from a three-arm randomized efficacy trial of Kaposi's sarcoma at Queen Elizabeth Central Hospital (QECH) of children aged {$<$}16 years. Patients were randomized to receive Vincristine monotherapy or Etoposide or Vincristine plus Bleomycin. The Cox, Weibull, Exponential and Frailty models were fitted to the data to obtain the adjusted effect of treatment on survival. The performance of models were compared using the Akaike's Information Criteria (AIC). Plots of log-log of survival against log of survival time, and the Schoenfeld's global tests were used to test suitability of the PH assumption. Results: Ninety-two patients were available for analyses of which 64\% were males, the mean age was 8 years (SD=2.8years) and 89\% were HIV positive. Exponential model was the best fitting method with AIC=174.1. Children treated with Vincristine monotherapy survived evidently poorly compared with those on Etoposide (HR=5.8, p=0.04). Conclusion: Exponential models can elicit more valid results than semi-parametric CoxPH model in a clinical trial with small sample size. This emphasizes the fact that when models are fitted to data, it is good practice to assess the goodness of fit and where appropriate alternative models should be fitted.},
  issue = {1},
  keywords = {1,analysis of clinical trials,because it,by cox,cox proportional hazards models,malawi,model is the most,parametric models,ph,requires few assumptions,small sample size,survival,the cox proportional hazards,the model was proposed,used approach in survival,widely}
}

