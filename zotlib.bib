  urldate = {2023-06-27},
  abstract = {In 2018, the Discovery and Validation of Biomarkers to Develop Non-Addictive Therapeutics for Pain workshop convened to discuss strategies to facilitate the development of biomarkers and end points for pain. The outcomes of this workshop are outlined in this Consensus Statement.},
