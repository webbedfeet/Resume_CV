@article{qiu:2025,
  title = {A {{Bayesian Dynamic Model}}‐{{Based Adaptive Design}} for {{Oncology Dose Optimization}} in {{Phase I}}/ {{{\textsc{II}}}} {{Clinical Trials}}},
