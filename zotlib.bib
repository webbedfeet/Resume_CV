@article{lal:2021,
  title = {Deep Learning-Based Enhancement of Epigenomics Data with {{AtacWorks}}},
  author = {Lal, Avantika and Chiang, Zachary D. and Yakovenko, Nikolai and Duarte, Fabiana M. and Israeli, Johnny and Buenrostro, Jason D.},
