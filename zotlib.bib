@article{gray_2014,
  title = {Clinical–{{Pathologic Stage Discrepancy}} in {{Bladder Cancer Patients Treated With Radical Cystectomy}}: {{Results From}} the {{National Cancer Data Base}}},
  shorttitle = {Clinical–{{Pathologic Stage Discrepancy}} in {{Bladder Cancer Patients Treated With Radical Cystectomy}}},
  author = {Gray, Phillip J. and Lin, Chun Chieh and Jemal, Ahmedin and Shipley, William U. and Fedewa, Stacey A. and Kibel, Adam S. and Rosenberg, Jonathan E. and Kamat, Ashish M. and Virgo, Katherine S. and Blute, Michael L. and Zietman, Anthony L. and Efstathiou, Jason A.},
  date = {2014-04-01},
  journaltitle = {International Journal of Radiation Oncology*Biology*Physics},
  shortjournal = {International Journal of Radiation Oncology*Biology*Physics},
  volume = {88},
  number = {5},
  pages = {1048--1056},
  issn = {0360-3016},
  doi = {10.1016/j.ijrobp.2014.01.001},
  url = {https://www.sciencedirect.com/science/article/pii/S0360301614000042},
  urldate = {2024-03-21},
  abstract = {Purpose To examine the accuracy of clinical staging and its effects on outcome in bladder cancer (BC) patients treated with radical cystectomy (RC), using a large national database. Methods and Materials A total of 16,953 patients with BC without distant metastases treated with RC from 1998 to 2009 were analyzed. Factors associated with clinical–pathologic stage discrepancy were assessed by multivariate generalized estimating equation models. Survival analysis was conducted for patients treated between 1998 and 2004 (n=7270) using the Kaplan-Meier method and Cox proportional hazards models. Results At RC 41.9\% of patients were upstaged, whereas 5.9\% were downstaged. Upstaging was more common in females, the elderly, and in patients who underwent a more extensive lymphadenectomy. Downstaging was less common in patients treated at community centers, in the elderly, and in Hispanics. Receipt of preoperative chemotherapy was highly associated with downstaging. Five-year overall survival rates for patients with clinical stages 0, I, II, III, and IV were 67.2\%, 62.9\%, 50.4\%, 36.9\%, and 27.2\%, respectively, whereas those for the same pathologic stages were 70.8\%, 75.8\%, 63.7\%, 41.5\%, and 24.7\%, respectively. On multivariate analysis, upstaging was associated with increased 5-year mortality (hazard ratio [HR] 1.80, P{$<$}.001), but downstaging was not associated with survival (HR 0.88, P=.160). In contrast, more extensive lymphadenectomy was associated with decreased 5-year mortality (HR 0.76 for ≥10 lymph nodes examined, P{$<$}.001), as was treatment at an National Cancer Institute–designated cancer center (HR 0.90, P=.042). Conclusions Clinical–pathologic stage discrepancy in BC patients is remarkably common across the United States. These findings should be considered when selecting patients for preoperative or nonoperative management strategies and when comparing the outcomes of bladder sparing approaches to RC.},
  file = {/Users/abhijit/Zotero/storage/ARMFJMRF/Gray et al. - 2014 - Clinical–Pathologic Stage Discrepancy in Bladder Cancer Patients Treated With Radical Cystectomy Re.pdf;/Users/abhijit/Zotero/storage/YECZQ5BS/1-s2.0-S0360301614000042-mmc1.pdf;/Users/abhijit/Zotero/storage/ENJFR7UT/S0360301614000042.html}
}

