@article{ranScDocCorrectingDropout2020,
  title = {{{scDoc}}: Correcting Drop-out Events in Single-Cell {{RNA-seq}} Data},
  shorttitle = {{{scDoc}}},
  author = {Ran, Di and Zhang, Shanshan and Lytal, Nicholas and An, Lingling},
  editor = {Robinson, Peter},
  date = {2020-08-01},
  journaltitle = {Bioinformatics},
  volume = {36},
  number = {15},
  pages = {4233--4239},
  issn = {1367-4803, 1460-2059},
  doi = {10.1093/bioinformatics/btaa283},
  url = {https://academic.oup.com/bioinformatics/article/36/15/4233/5828931},
  urldate = {2023-01-09},
  abstract = {Abstract                            Motivation               Single-cell RNA-sequencing (scRNA-seq) has become an important tool to unravel cellular heterogeneity, discover new cell (sub)types, and understand cell development at single-cell resolution. However, one major challenge to scRNA-seq research is the presence of ‘drop-out’ events, which usually is due to extremely low mRNA input or the stochastic nature of gene expression. In this article, we present a novel single-cell RNA-seq drop-out correction (scDoc) method, imputing drop-out events by borrowing information for the same gene from highly similar cells.                                         Results               scDoc is the first method that directly involves drop-out information to accounting for cell-to-cell similarity estimation, which is crucial in scRNA-seq drop-out imputation but has not been appropriately examined. We evaluated the performance of scDoc using both simulated data and real scRNA-seq studies. Results show that scDoc outperforms the existing imputation methods in reference to data visualization, cell subpopulation identification and differential expression detection in scRNA-seq data.                                         Availability and implementation               R code is available at https://github.com/anlingUA/scDoc.                                         Supplementary information               Supplementary data are available at Bioinformatics online.},
  langid = {english},
  keywords = {scrna},
  note = {\section{Annotations\\
(1/9/2023, 3:19:29 PM)}

\par
“One of the greatest challenges of scRNA-seq is the so-called ‘drop-out’ phenomenon, occurring when ‘a gene is observed at moderate or even high expression level in one cell but is not detected in another cell’” (Ran et al., 2020, p. 4233)
\par
“it is due to the lack of efficiency in capturing the single-cell transcriptome during library preparation steps such as RNA reverse transcription into the first-strand cDNA, second-strand synthesis and cDNA amplification” (Ran et al., 2020, p. 4233)
\par
“not only zero expression values but also a portion of nearzero expression measurements should be considered as drop-out events” (Ran et al., 2020, p. 4233)
\par
“Drop-out events, which interface with high noise and outlier events” (Ran et al., 2020, p. 4233)
\par
“the fundamental challenge is to identify ‘similar’ cells” (Ran et al., 2020, p. 4234)
\par
“t is necessary to separate technical zeros (due to drop-out) from biological zeros, and technically low expression (near-zero counts due to drop-outs) from biologically low expression.” (Ran et al., 2020, p. 4234)
\par
“scDoc utilizes a novel two-component mixture model, PNB, to assess whether an observed count belongs to a drop-out event. In PNB, the first component, Poisson distribution, is used to account for the ‘drop-outs’ and the second component, negative binomial (NB) distribution, is used to represent the ‘actual expression’ (it could be zero or a non-zero value).” (Ran et al., 2020, p. 4234)
\par
“posterior probability dgi (or di for simplicity) is then calculated as: di ¼ \textasciicircum{} pi fPois yi; \textasciicircum ki \textasciicircum{} pi fPois yi; \textasciicircum ki þð1 \textasciicircum{} piÞ fNBðyi; \textasciicircum{} li; \textasciicircum{} /Þ ; where \textasciicircum ki, \textasciicircum{} li, \textasciicircum{} / and \textasciicircum{} pi are the estimates from the above EM algorithm” (Ran et al., 2020, p. 4234)
\par
“The drop-out rate for a gene is defined as the proportion of detected drop-out events across all cells.” (Ran et al., 2020, p. 4234)},
  file = {/Users/abhijit/Zotero/storage/4MVTWNEV/Ran et al. - 2020 - scDoc correcting drop-out events in single-cell RNA-seq data.pdf}
}

@article{ratcliffeJointModelingLongitudinal2004,
  title = {Joint {{Modeling}} of {{Longitudinal}} and {{Survival Data}} via a {{Common Frailty}}},
  author = {Ratcliffe, Sarah J. and Guo, Wensheng and Have, Thomas R. Ten},
  date = {2004},
  journaltitle = {Biometrics},
  volume = {60},
