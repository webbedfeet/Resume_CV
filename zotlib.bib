@article{yanPotentialApplicationsDeep2021,
  title = {Potential Applications of Deep Learning in Single-Cell {{RNA}} Sequencing Analysis for Cell Therapy and Regenerative Medicine},
  author = {Yan, Ruojin and Fan, Chunmei and Yin, Zi and Wang, Tingzhang and Chen, Xiao},
  date = {2021},
  journaltitle = {STEM CELLS},
  volume = {39},
