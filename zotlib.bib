@inproceedings{DeepMultitaskGaussian2017,
  title = {Deep {{Multi-task Gaussian Processes}} for {{Survival Analysis}} with {{Competing Risks}}},
  booktitle = {Advances in {{Neural Information Processing Systems}}},
