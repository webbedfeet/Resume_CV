@article{ciolino:2023,
  title = {Guidance on Interim Analysis Methods in Clinical Trials},
  author = {Ciolino, Jody D. and Kaizer, Alexander M. and Bonner, Lauren Balmert},
  date = {2023},
  journaltitle = {Journal of Clinical and Translational Science},
  shortjournal = {J Clin Transl Sci},
  volume = {7},
  number = {1},
  eprint = {37313374},
  eprinttype = {pubmed},
  pages = {e124},
  issn = {2059-8661},
  doi = {10.1017/cts.2023.552},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10260346/},
  urldate = {2023-07-18},
  abstract = {Interim analyses in clinical trials can take on a multitude of forms. They are often used to guide Data and Safety Monitoring Board (DSMB) recommendations to study teams regarding recruitment targets for large, later-phase clinical trials. As collaborative biostatisticians working and teaching in multiple fields of research and across a broad array of trial phases, we note the large heterogeneity and confusion surrounding interim analyses in clinical trials. Thus, in this paper, we aim to provide a general overview and guidance on interim analyses for a nonstatistical audience. We explain each of the following types of interim analyses: efficacy, futility, safety, and sample size re-estimation, and we provide the reader with reasoning, examples, and implications for each. We emphasize that while the types of interim analyses employed may differ depending on the nature of the study, we would always recommend prespecification of the interim analytic plan to the extent possible with risk mitigation and trial integrity remaining a priority. Finally, we posit that interim analyses should be used as tools to help the DSMB make informed decisions in the context of the overarching study. They should generally not be deemed binding, and they should not be reviewed in isolation.},
  pmcid = {PMC10260346},
  file = {/Users/abhijit/Zotero/storage/MAKCIZ98/Ciolino et al. - 2023 - Guidance on interim analysis methods in clinical trials.pdf}
