  date = {2025-09-17},
  journaltitle = {BMJ Evidence-Based Medicine},
  eprint = {40962433},
  eprinttype = {pubmed},
  publisher = {Royal Society of Medicine},
  issn = {2515-446X, 2515-4478},
  doi = {10.1136/bmjebm-2025-113730},
  url = {https://ebm.bmj.com/content/early/2025/09/17/bmjebm-2025-113730},
  urldate = {2025-10-09},
  abstract = {Joseph Alderman et al argue that predictive models in healthcare lack adequate oversight and regulation. They highlight the potential risks to patients and call for improved governance to ensure the safety and efficacy of these tools.  Thousands of prognostic models, diagnostic models, clinical risk scores and clinical scoring systems (hereafter simply ‘predictive models’) are developed each year to estimate health outcomes or risks in individuals. Most models are used to guide decisions about patient care, from prescribing medications to recommending surgery,1 2 but few have been rigorously evaluated for accuracy and clinical utility. We argue that many lack adequate oversight, potentially leading to misdiagnosis, inappropriate treatment and the perpetuation of health inequalities (Box 1). Box 1  \#\#\# Key messages In some cases, predictive models are straightforward—simple numerical rules or calculations that could be completed with pen and paper. In other cases, they may use statistical modelling (commonly linear, logistic or Cox regression) or machine learning approaches and require a calculator or computer to generate a result. The use of predictive models to provide patients with quantified risk estimates is frequently recommended in clinical guidelines issued by professional bodies …},
  langid = {english},
  keywords = {Clinical Decision-Making,Information Science,Methods,Prognosis}
}

