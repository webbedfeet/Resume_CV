@article{alford:2017,
  title = {The {{Use}} of {{Biomarkers}} in {{Prostate Cancer Screening}} and {{Treatment}}},
  author = {Alford, Ashley V. and Brito, Joseph M. and Yadav, Kamlesh K. and Yadav, Shalini S. and Tewari, Ashutosh K. and Renzulli, Joseph},
  date = {2017},
  journaltitle = {Reviews in Urology},
  shortjournal = {Rev Urol},
  volume = {19},
