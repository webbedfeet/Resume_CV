@article{handorf:2024,
  title = {Analysis of Survival Data with Nonproportional Hazards: {{A}} Comparison of Propensity-Score-Weighted Methods},
  shorttitle = {Analysis of Survival Data with Nonproportional Hazards},
  author = {Handorf, Elizabeth A. and Smaldone, Marc C. and Movva, Sujana and Mitra, Nandita},
  date = {2024},
  journaltitle = {Biometrical Journal},
  volume = {66},
  number = {1},
