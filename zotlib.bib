  shorttitle = {Risk-Conscious Correction of Batch Effects},
  author = {Oytam, Yalchin and Sobhanmanesh, Fariborz and Duesing, Konsta and Bowden, Joshua C. and Osmond-McLeod, Megan and Ross, Jason},
  date = {2016-09-01},
