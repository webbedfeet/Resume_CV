@article{Wang2005,
  title = {Towards Improved Biomarker Studies of Cervical Neoplasia: Effects of Precolposcopic Procedures on Gene Expression Patterns.},
  author = {Wang, Sophia S and Dasgupta, Abhijit and Sherman, Mark E and Walker, Joan L and Gold, Michael A and Zuna, Rosemary and Sakoda, Lori and Wacholder, Sholom and Schiffman, Mark and Baker, Carl C},
  date = {2005-06},
  journaltitle = {Diagnostic Molecular Pathology : The American Journal Of Surgical Pathology, Part B},
