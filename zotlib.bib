  shorttitle = {Conservative {{Management Following Complete Clinical Response}} to {{Neoadjuvant Chemotherapy}} of {{Muscle Invasive Bladder Cancer}}},
  author = {Mazza, Patrick and Moran, George W. and Li, Gen and Robins, Dennis J. and Matulay, Justin T. and Herr, Harry W. and Decastro, Guarionex J. and McKiernan, James M. and Anderson, Christopher B.},
  date = {2018-11},
  journaltitle = {The Journal of urology},
  shortjournal = {J Urol},
  volume = {200},
  number = {5},
  eprint = {29787740},
