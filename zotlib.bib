@article{Lacourt2010,
  title = {Attributable Risk in Men in Two {{French}} Case-Control Studies on Mesothelioma and Asbestos},
  author = {Lacourt, Aude and Rolland, Patrick and Gramond, Céline and Astoul, Philippe and Chamming's, Soizick and Ducamp, Stéphane and Frenay, Catherine and Galateau-Sallé, Françoise and Gilg Soit Ilg, Anabelle and Imbernon, Ellen and Le Stang, Nolwenn and Pairon, Jean Claude and Goldberg, Marcel and Iwatsubo, Yuriko and Salmi, Louis-Rachid and Brochard, Patrick},
  date = {2010},
  journaltitle = {European journal of epidemiology},
  location = {Laboratoire Santé Travail Environnement, EA 3672, Institut de Santé Publique, d'Epidémiologie et de Développement, Université Victor Segalen Bordeaux 2, 33076, Bordeaux, France, aude.lacourt@isped.u-bordeaux2.fr.},
  url = {papers2://publication/doi/10.1007/s10654-010-9502-0},
  abstract = {Pleural mesothelioma is a primary tumor of the pleura that is mainly due to asbestos exposure. To study the relationship between mesothelioma and occupational asbestos exposure in France, two case-control studies (A and B) were conducted. A substantial difference in the attributable risk in the population (AR(p)) was observed among men: 44.5\% (95\% CI: [32.6-56.4]) in study A and 83.2\% (95\% CI: [76.8-89.6]) in study B. As different exposure assessment expert methods were used, the main objective of this work was to re-estimate the AR(p) men in two case-control studies according to a common standardized exposure assessment by using a Job Exposure Matrix (JEM) and to assess the role of subjects' selection. The initial observed AR(p) difference was maintained: 36.3\% (95\% CI: [24.3-50.3]) in study A and 69.7\% (95\% CI: [51.7-83.2]) in study B. Further investigations highlighted the potential selection bias introduced in both studies, especially among controls. The AR(p) could be underestimated in study A and overestimated in study B. After weighting subjects according to distribution of socio-economic status in the general population for controls and according to distribution of socio-economic status of cases registered by the French National Mesothelioma Surveillance Program, re-estimated AR(p) values were 52.4\% in study A and 70.2\% in study B. These results provide additional information to describe the relationship between pleural mesothelioma and occupational asbestos exposure, but also confirm the importance of subjects' recruitment in case control studies, particularly control selection.}
}

