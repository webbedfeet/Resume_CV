@article{drummond:2024,
  title = {Definitions and {{Characteristics}} of {{Patient Digital Twins Being Developed}} for {{Clinical Use}}: {{Scoping Review}}},
  shorttitle = {Definitions and {{Characteristics}} of {{Patient Digital Twins Being Developed}} for {{Clinical Use}}},
  author = {Drummond, David and Gonsard, Apolline},
  date = {2024-11-13},
  journaltitle = {Journal of Medical Internet Research},
  volume = {26},
  number = {1},
  pages = {e58504},
  publisher = {JMIR Publications Inc., Toronto, Canada},
  doi = {10.2196/58504},
  url = {https://www.jmir.org/2024/1/e58504},
  urldate = {2025-11-21},
  abstract = {Background: The concept of digital twins, widely adopted in industry, is entering health care. However, there is a lack of consensus on what constitutes the digital twin of a patient. Objective: The objective of this scoping review was to analyze definitions and characteristics of patient digital twins being developed for clinical use, as reported in the scientific literature. Methods: We searched PubMed, Scopus, Embase, IEEE, and Google Scholar for studies claiming digital twin development or evaluation until August 2023. Data on definitions, characteristics, and development phase were extracted. Unsupervised classification of claimed digital twins was performed. Results: We identified 86 papers representing 80 unique claimed digital twins, with 98\% (78/80) in preclinical phases. Among the 55 papers defining “digital twin,” 76\% (42/55) described a digital replica, 42\% (23/55) mentioned real-time updates, 24\% (13/55) emphasized patient specificity, and 15\% (8/55) included 2-way communication. Among claimed digital twins, 60\% (48/80) represented specific organs (primarily heart: 15/48, 31\%; bones or joints: 10/48, 21\%; lung: 6/48, 12\%; and arteries: 5/48, 10\%); 14\% (11/80) embodied biological systems such as the immune system; and 26\% (21/80) corresponded to other products (prediction models, etc). The patient data used to develop and run the claimed digital twins encompassed medical imaging examinations (35/80, 44\% of publications), clinical notes (15/80, 19\% of publications), laboratory test results (13/80, 16\% of publications), wearable device data (12/80, 15\% of publications), and other modalities (32/80, 40\% of publications). Regarding data flow between patients and their virtual counterparts, 16\% (13/80) claimed that digital twins involved no flow from patient to digital twin, 73\% (58/80) used 1-way flow from patient to digital twin, and 11\% (9/80) enabled 2-way data flow between patient and digital twin. Based on these characteristics, unsupervised classification revealed 3 clusters: simulation patient digital twins in 54\% (43/80) of publications, monitoring patient digital twins in 28\% (22/80) of publications, and research-oriented models unlinked to specific patients in 19\% (15/80) of publications. Simulation patient digital twins used computational modeling for personalized predictions and therapy evaluations, mostly for one-time assessments, and monitoring digital twins harnessed aggregated patient data for continuous risk or outcome forecasting and care optimization. Conclusions: We propose defining a patient digital twin as “a viewable digital replica of a patient, organ, or biological system that contains multidimensional, patient-specific information and informs decisions” and to distinguish simulation and monitoring digital twins. These proposed definitions and subtypes offer a framework to guide research into realizing the potential of these personalized, integrative technologies to advance clinical care.},
  langid = {english},
  file = {/Users/abhijit/Zotero/storage/L8KA2T9R/Drummond and Gonsard - 2024 - Definitions and Characteristics of Patient Digital Twins Being Developed for Clinical Use Scoping R.pdf;/Users/abhijit/Zotero/storage/9FH9TNAU/e58504.html}
}

@misc{DSMBDJuly18,
  title = {{{DSMB-D July}} 18, 2023 {{Electronic Meeting Packet}}},
  note = {\section{Annotations\\
(7/18/2023, 12:08:47 AM)}

\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 1) Increased CHAMP sites from 24 to 38
\par
“Major Depressive Disorder (MDD) is one of the most disabling medical conditions worldwide and currently available treatments fall short of addressing this large public health burden.” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 17)
\par
“the current project will assess change in depressive symptoms, anhedonia, and brain reward function following treatment with XEN1101 or placebo in participants with depression and anhedonia, and will examine the relationship between change in clinical symptoms and reward circuit activity” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 17)
\par
“This is a phase II, randomized, parallel-arm, placebo-controlled clinical trial.” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 17)
\par
“N=60 participants with MDD will be randomized in a 1:1 fashion to XEN1101 (N=30) or matching placebo (N=30).” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 17)
\par
“Primary Analysis: The primary endpoint is the change in activation of the bilateral VS, a region of the rewards circuit in the brain. A mixed model with random intercept will be used to compare change in bilateral VS from baseline to week 8 between XEN1101 and placebo. The covariates in the model will include treatment, time and an interaction between treatment and time. Due to the small sample size, no additional covariates will be included. The analyses will be conducted at a two-sided 0.10 significance level in the ITT population.” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 19)
\par
“Secondary Analysis: For the secondary measures, changes in MADRS and SHAPS over time across baseline, weeks 2, 4, 6, and 8 will be compared between randomization groups using a mixed model with random intercept and possibly random slope. The analyses will be conducted at a two-sided 0.10 significance level in the ITT population” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 19)
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 26) They seem to be very close to catching up to their expected numbers, which is great!
\par
“The purpose of this trial is to test whether Collaborative Care (Collaborative Care) that addresses both mental health symptoms (MHS) and co-occurring opioid use disorder (OUD) can improve patient lives. This trial will also examine the effectiveness of screening for Opioid Use Disorder (OUD) and effectiveness of high or low sustainment support” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 60)
\par
“Our target is to enroll and treat 1200 eligible patients (with a lower bound of 360) who screen positive for OUD and MHD over 39 months.” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 60)
\par
“38 sites randomized as of April 2023; of those, 26 are enrolling.” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 60)
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 68) Cohort 2 is well behind~ (66 out of expected 102)
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 69) Is the uneven enrollment between the treatment groups by design?

It's due to the cluster randomization and the fact that several centers in Group B have not consented a single patient. Does the analysis plan account for the differential enrollment rate between the arms, and the consequent imbalance? Actually this issue further hinders their actual statistical power.
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 71) Cohort 2 is also about 3/4th women
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 72) Cohort 2 is doing better, but in general recruitment is massively white
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 76) Still struggling to get to 360. The massive decrease from 1200 to 360 as a target probably indicates a poorly powered study
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 99) The clinics are randomized, not the subjects. So if you have clinics who are not enrolling yet or have lower enrollment, you'll have differences in subjects between the arms
\par
“Given the cluster-randomization we will use appropriate mixed models (also known as multi-level models) to account for clinic effects that are shared by subjects from the same clinic” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 118)
\par
“We have focused on the integration of the improved study procedures at both sites which include: • More detailed and timely AE and deviation tracking with daily TMS monitoring forms • Improved re-evaluation procedures and documentation of eligibility for participants who are delayed in their treatment start” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 147)
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 156) Generally doing pretty well with enrollment
\par
“Requesting discussion of an interim power analysis for the CLARO study (Contact PI: Watkins) and the associated competitive revision (CLARO+) that will most precisely estimate the sample size needed to detect an effect of the interventions on the primary outcomes. Requesting the DSMB consider an approach that involves breaking the blind (fully or partially), if it means a more precise sample size estimate when compared to other sample size estimation approaches.” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 167)
\par
“We propose to execute an interim analysis to assess whether we have any evidence of a treatment effect in our currently enrolled study sample. We request this interim look at the data given challenges we have had with recruiting to our targeted sample size.” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 174)
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 176) If you're doing an interim analysis at 5\% significance, you've blown up your alpha for the final analysis. So technically, to preserve your final Type I error, this interim analysis would have to be done at a much stricter Type I level.
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 176) These models are appropriate for purpose
\par
“We will extend the randomized trial from the parent study to allow for a comparison of CCCOD+ to CC-COD.” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 204)
\par
“A total of 900 individuals will be randomized between CC-COD and EUC (Phase I) and a total of 300 individuals will be randomized between CC-COD+ and EUC (Phase II). Based on data from the INSPIRE study, we assume 80\% of patients have family members who are willing to participate in treatment and that the effect of CC-COD+ for the 20\% of patients without family members willing to participate will be the same as CC-COD. Using the same assumptions as the parent study power calculations, we have 80\% power to detect an incremental effect of CCCOD+ over CC-COD on the number of days of continuous MOUD care of 14 days.” (“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 205)
\par
(“DSMB-D July 18, 2023 Electronic Meeting Packet”, p. 205) What do you mean by "detect an incremental effect"?},
  file = {/Users/abhijit/Zotero/storage/DZJBE59X/DSMB-D July 18, 2023 Electronic Meeting Packet.pdf}
}

@article{dugue:2016,
