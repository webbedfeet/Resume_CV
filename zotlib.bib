  author = {Hinne, Max and Gronau, Quentin F. and family=Bergh, given=Don, prefix=van den, useprefix=true and Wagenmakers, Eric-Jan},
  date = {2020-06-01},
  journaltitle = {Advances in Methods and Practices in Psychological Science},
  volume = {3},
