@incollection{jia:2020,
  title = {A {{Novel Method}} of {{Subgroup Identification}} by {{Combining Virtual Twins}} with {{GUIDE}} ({{VG}}) for {{Development}} of {{Precision Medicines}}},
  booktitle = {Design and {{Analysis}} of {{Subgroups}} with {{Biopharmaceutical Applications}}},
  author = {Jia, Jia and Tang, Qi and Xie, Wangang},
  editor = {Ting, Naitee and Cappelleri, Joseph C. and Ho, Shuyen and Chen, (Din) Ding-Geng},
  date = {2020},
  series = {Emerging {{Topics}} in {{Statistics}} and {{Biostatistics}}},
  pages = {167--180},
