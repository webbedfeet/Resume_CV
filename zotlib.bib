  author = {Hédou, Julien and Marić, Ivana and Bellan, Grégoire and Einhaus, Jakob and Gaudillière, Dyani K. and Ladant, Francois-Xavier and Verdonk, Franck and Stelzer, Ina A. and Feyaerts, Dorien and Tsai, Amy S. and Ganio, Edward A. and Sabayev, Maximilian and Gillard, Joshua and Amar, Jonas and Cambriel, Amelie and Oskotsky, Tomiko T. and Roldan, Alennie and Golob, Jonathan L. and Sirota, Marina and Bonham, Thomas A. and Sato, Masaki and Diop, Maïgane and Durand, Xavier and Angst, Martin S. and Stevenson, David K. and Aghaeepour, Nima and Montanari, Andrea and Gaudillière, Brice},
  date = {2024-01-02},
  journaltitle = {Nature Biotechnology},
