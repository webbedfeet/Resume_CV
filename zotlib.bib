@article{shi:2024,
  title = {Bayesian Inference for the Onset Time and Epidemiological Characteristics of Emerging Infectious Diseases},
  author = {Shi, Benyun and Yang, Sanguo and Tan, Qi and Zhou, Lian and Liu, Yang and Zhou, Xiaohong and Liu, Jiming},
  date = {2024},
  journaltitle = {Frontiers in Public Health},
  shortjournal = {Front Public Health},
  volume = {12},
  eprint = {38827615},
  eprinttype = {pubmed},
  pages = {1406566},
  issn = {2296-2565},
  doi = {10.3389/fpubh.2024.1406566},
  abstract = {BACKGROUND: Emerging infectious diseases pose a significant threat to global public health. Timely detection and response are crucial in mitigating the spread of such epidemics. Inferring the onset time and epidemiological characteristics is vital for accelerating early interventions, but accurately predicting these parameters in the early stages remains challenging. METHODS: We introduce a Bayesian inference method to fit epidemic models to time series data based on state-space modeling, employing a stochastic Susceptible-Exposed-Infectious-Removed (SEIR) model for transmission dynamics analysis. Our approach uses the particle Markov chain Monte Carlo (PMCMC) method to estimate key epidemiological parameters, including the onset time, the transmission rate, and the recovery rate. The PMCMC algorithm integrates the advantageous aspects of both MCMC and particle filtering methodologies to yield a computationally feasible and effective means of approximating the likelihood function, especially when it is computationally intractable. RESULTS: To validate the proposed method, we conduct case studies on COVID-19 outbreaks in Wuhan, Shanghai and Nanjing, China, respectively. Using early-stage case reports, the PMCMC algorithm accurately predicted the onset time, key epidemiological parameters, and the basic reproduction number. These findings are consistent with empirical studies and the literature. CONCLUSION: This study presents a robust Bayesian inference method for the timely investigation of emerging infectious diseases. By accurately estimating the onset time and essential epidemiological parameters, our approach is versatile and efficient, extending its utility beyond COVID-19.},
  langid = {english},
  pmcid = {PMC11140066},
  keywords = {Algorithms,Bayes Theorem,Bayesian inference,China,Communicable Diseases Emerging,COVID-19,Disease Outbreaks,emerging infectious disease (EID),epidemiological characteristics,Epidemiological Models,Humans,Markov Chains,Monte Carlo Method,Particle Markov chain Monte Carlo,SARS-CoV-2,SEIR compartmental model,Time Factors},
  file = {/Users/abhijit/Zotero/storage/B3QEJ7VJ/Shi et al. - 2024 - Bayesian inference for the onset time and epidemiological characteristics of emerging infectious dis.pdf}
}

