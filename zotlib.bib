@article{parkModelSelectionDiagnostics2014,
  title = {Model Selection and Diagnostics for Joint Modeling of Survival and Longitudinal Data with Crossing Hazard Rate Functions},
  author = {Park, Ka Young and Qiu, Peihua},
  date = {2014},
  journaltitle = {Statistics in Medicine},
  volume = {33},
  number = {26},
  pages = {4532--4546},
  issn = {1097-0258},
  doi = {10.1002/sim.6259},
  url = {https://www.onlinelibrary.wiley.com/doi/abs/10.1002/sim.6259},
  urldate = {2021-01-12},
  abstract = {Comparison of two hazard rate functions is important for evaluating treatment effect in studies concerning times to some important events. In practice, it may happen that the two hazard rate functions cross each other at one or more unknown time points, representing temporal changes of the treatment effect. Also, besides survival data, there could be longitudinal data available regarding some time-dependent covariates. When jointly modeling the survival and longitudinal data in such cases, model selection and model diagnostics are especially important to provide reliable statistical analysis of the data, which are lacking in the literature. In this paper, we discuss several criteria for assessing model fit that have been used for model selection and apply them to the joint modeling of survival and longitudinal data for comparing two crossing hazard rate functions. We also propose hypothesis testing and graphical methods for model diagnostics of the proposed joint modeling approach. Our proposed methods are illustrated by a simulation study and by a real-data example concerning two early breast cancer treatments. Copyright © 2014 John Wiley \& Sons, Ltd.},
  langid = {english},
  keywords = {crossing hazard rates,joint model,longitudinal data,model diagnostics,model selection,survival data},
  file = {/Users/abhijit/Zotero/storage/Q7GC8JCR/Park and Qiu - 2014 - Model selection and diagnostics for joint modeling.pdf;/Users/abhijit/Zotero/storage/YGL8NYWZ/Park and Qiu - 2014 - Model selection and diagnostics for joint modeling of survival and longitudinal data with crossing h.pdf}
}

