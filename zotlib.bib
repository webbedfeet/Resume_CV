  author = {Graf, Erika and Schmoor, Claudia and Sauerbrei, Willi and Schumacher, Martin},
  date = {1999},
  journaltitle = {Statistics in Medicine},
  volume = {18},
  number = {17--18},
  pages = {2529--2545},
