@article{Murphy1999,
  title = {Changes in Parents' Mental Distress after the Violent Death of an Adolescent or Young Adult Child: A Longitudinal Prospective Analysis.},
  author = {Murphy, S A and Dasgupta, A and Cain, K C and Johnson, L C and Lohan, J and Wu, L and Mekwa, J},
