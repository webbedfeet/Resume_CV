@article{sainburg:2021,
  title = {Parametric {{UMAP Embeddings}} for {{Representation}} and {{Semisupervised Learning}}.},
  author = {Sainburg, Tim and {Leland McInnes} and McInnes, Leland and Gentner, Timothy Q.},
  date = {2021-08-30},
