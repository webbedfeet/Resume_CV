  author = {Choi, Kwangbom and Chen, Yang and Skelly, Daniel A. and Churchill, Gary A.},
  date = {2020-12},
  journaltitle = {Genome Biology},
  shortjournal = {Genome Biol},
  volume = {21},
  number = {1},
