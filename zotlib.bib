  note = {Comment: 50 pages, 5 figures},
  file = {/Users/abhijit/Zotero/storage/TV9LSRSP/Brilleman et al. - 2020 - Bayesian Survival Analysis Using the rstanarm R Package.pdf;/Users/abhijit/Zotero/storage/VMP9BW7X/2002.html}
}

