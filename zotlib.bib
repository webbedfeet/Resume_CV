@article{caglayanMicrosimulationModelingOncology2018,
  title = {Microsimulation {{Modeling}} in {{Oncology}}},
  author = {Çağlayan, Çağlar and Terawaki, Hiromi and Chen, Qiushi and Rai, Ashish and Ayer, Turgay and Flowers, Christopher R.},
  date = {2018-12},
  journaltitle = {JCO Clinical Cancer Informatics},
  shortjournal = {JCO Clinical Cancer Informatics},
