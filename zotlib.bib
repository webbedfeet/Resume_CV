  author = {Chen, Liang and Zhai, Yuyao and He, Qiuyan and Wang, Weinan and Deng, Minghua},
  date = {2020-07-14},
  journaltitle = {Genes},
  shortjournal = {Genes (Basel)},
  volume = {11},
  number = {7},
  eprint = {32674393},
  eprinttype = {pubmed},
  pages = {E792},
  issn = {2073-4425},
  doi = {10.3390/genes11070792},
  abstract = {As single-cell RNA sequencing technologies mature, massive gene expression profiles can be obtained. Consequently, cell clustering and annotation become two crucial and fundamental procedures affecting other specific downstream analyses. Most existing single-cell RNA-seq (scRNA-seq) data clustering algorithms do not take into account the available cell annotation results on the same tissues or organisms from other laboratories. Nonetheless, such data could assist and guide the clustering process on the target dataset. Identifying marker genes through differential expression analysis to manually annotate large amounts of cells also costs labor and resources. Therefore, in this paper, we propose a novel end-to-end cell supervised clustering and annotation framework called scAnCluster, which fully utilizes the cell type labels available from reference data to facilitate the cell clustering and annotation on the unlabeled target data. Our algorithm integrates deep supervised learning, self-supervised learning and unsupervised learning techniques together, and it outperforms other customized scRNA-seq supervised clustering methods in both simulation and real data. It is particularly worth noting that our method performs well on the challenging task of discovering novel cell types that are absent in the reference data.},
  langid = {english},
  pmcid = {PMC7397036},
  keywords = {Cluster Analysis,clustering and annotation,Computer Simulation,Gene Expression Profiling,Genetic Markers,Molecular Sequence Annotation,RNA-Seq,self-supervised learning,Sequence Analysis RNA,Single-Cell Analysis,single-cell RNA sequencing,supervised learning,Transcriptome,unsupervised learning,Unsupervised Machine Learning,Whole Exome Sequencing},
  file = {/Users/abhijit/Zotero/storage/566IZYKK/Chen et al_2020_Integrating Deep Supervised, Self-Supervised and Unsupervised Learning for.pdf;/Users/abhijit/Zotero/storage/WAK7RPF9/Chen et al. - 2020 - Integrating Deep Supervised, Self-Supervised and Unsupervised Learning for Single-Cell RNA-seq Clust.pdf;/Users/abhijit/Zotero/storage/KCWAWWZU/792.html}
}

@article{chen:2021,
  title = {Prognostic {{Significance}} of {{Blood-Based Multi-cancer Detection}} in {{Plasma Cell-Free DNA}}},
  author = {Chen, Xiaoji and Dong, Zhao and Hubbell, Earl and Kurtzman, Kathryn N. and Oxnard, Geoffrey R. and Venn, Oliver and Melton, Collin and Clarke, Christina A. and Shaknovich, Rita and Ma, Ting and Meixiong, Gerry and Seiden, Michael V. and Klein, Eric A. and Fung, Eric T. and Liu, Minetta C.},
  date = {2021-08-01},
  journaltitle = {Clinical Cancer Research},
  shortjournal = {Clin Cancer Res},
  volume = {27},
  number = {15},
  eprint = {34088722},
  eprinttype = {pubmed},
  pages = {4221--4229},
  issn = {1078-0432},
  doi = {10.1158/1078-0432.CCR-21-0417},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9401481/},
  urldate = {2023-04-20},
  abstract = {Purpose: We recently reported the development of a cell-free DNA (cfDNA) targeted methylation (TM)-based sequencing approach for a multi-cancer early detection (MCED) test that includes cancer signal origin prediction. Here, we evaluated the prognostic significance of cancer detection by the MCED test using longitudinal follow-up data. Experimental Design: As part of a Circulating Cell-free Genome Atlas (CCGA) substudy, plasma cfDNA samples were sequenced using a TM approach, and machine learning classifiers predicted cancer status and cancer signal origin. Overall survival (OS) of cancer participants in the first 3 years of follow-up was evaluated in relation to cancer detection by the MCED test and clinical characteristics. Results: Cancers not detected by the MCED test had significantly better OS (P {$<$} 0.0001) than cancers detected, even after accounting for other covariates, including clinical stage and method of clinical diagnosis (i.e., standard-of-care screening or clinical presentation with signs/symptoms). Additionally, cancers not detected by the MCED test had better OS than was expected when data were adjusted for age, stage, and cancer type from the Surveillance, Epidemiology, and End Results (SEER) program. In cancers with current screening options, the MCED test also differentiated more aggressive cancers from less aggressive cancers (P {$<$} 0.0001). Conclusions: Cancer detection by the MCED test was prognostic beyond clinical stage and method of diagnosis. Cancers not detected by the MCED test had better prognosis than cancers detected and SEER-based expected survival. Cancer detection and prognosis may be linked by the underlying biological factor of tumor fraction in cfDNA.},
  pmcid = {PMC9401481},
  keywords = {ctdna},
  file = {/Users/abhijit/Zotero/storage/FY9J3KE9/Chen et al. - 2021 - Prognostic Significance of Blood-Based Multi-cancer Detection in Plasma Cell-Free DNA.pdf}
}

