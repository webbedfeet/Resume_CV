@report{wagner:2018,
  type = {preprint},
  title = {Moana: {{A}} Robust and Scalable Cell Type Classification Framework for Single-Cell {{RNA-Seq}} Data},
  shorttitle = {Moana},
  author = {Wagner, Florian and Yanai, Itai},
