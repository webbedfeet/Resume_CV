@article{thijssen_2016,
  title = {{{BCM}}: Toolkit for {{Bayesian}} Analysis of {{Computational Models}} Using Samplers},
  shorttitle = {{{BCM}}},
  author = {Thijssen, Bram and Dijkstra, Tjeerd M. H. and Heskes, Tom and Wessels, Lodewyk F. A.},
  date = {2016-12},
  journaltitle = {BMC Systems Biology},
  shortjournal = {BMC Syst Biol},
  volume = {10},
