@article{Schiffman2005,
  title = {A Comparison of a Prototype {{PCR}} Assay and Hybrid Capture 2 for Detection of Carcinogenic Human Papillomavirus {{DNA}} in Women with Equivocal or Mildly Abnormal Papanicolaou Smears.},
  author = {Schiffman, Mark and Wheeler, Cosette M and Dasgupta, Abhijit and Solomon, Diane and Castle, Philip E},
  date = {2005-11},
  journaltitle = {American Journal Of Clinical Pathology},
  volume = {124},
